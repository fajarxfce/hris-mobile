<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".HrisScheduledProofApplication"
        android:allowBackup="false"
        android:label="HRIS Protocol Proof"
        android:usesCleartextTraffic="true">
        <provider android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup" android:exported="false" tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" android:value="androidx.startup" tools:node="remove" />
        </provider>
        <activity android:name=".HrisScheduledProofActivity" android:exported="true" />
    </application>
    <instrumentation
        android:name=".MatrixProofInstrumentation"
        android:functionalTest="true"
        android:targetPackage="dev.fajar.hris.collaboration.proof" />
</manifest>
