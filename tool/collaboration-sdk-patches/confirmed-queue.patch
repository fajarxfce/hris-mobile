+/// Original queue contents; rejection never returns an incomplete subset.
+pub enum QueuedEventSnapshot {
+    /// Complete original transaction/content pairs from the paused native store.
+    Ready(Vec<(OwnedTransactionId, SerializableEventContent)>),
+    /// The queue is enabled.
+    QueueEnabled,
+    /// A request is still in flight.
+    InFlight,
+    /// The queue contains an upload or redaction.
+    NotAnEvent,
+    /// Dependent requests could change or synthesize the original content.
+    DependentWork,
+}
+
+impl std::fmt::Debug for QueuedEventSnapshot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Ready(_) => "Ready([redacted])",
+            Self::QueueEnabled => "QueueEnabled",
+            Self::InFlight => "InFlight",
+            Self::NotAnEvent => "NotAnEvent",
+            Self::DependentWork => "DependentWork",
+        })
+    }
+}
+
+/// Result of matching external confirmation to an existing paused queue event.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ConfirmedEventSettlement {
+    /// The exact native entry was removed and its confirmed ID was published locally.
+    Settled,
+    /// No queue entry exists with this transaction ID.
+    Missing,
+    /// The queue is enabled; no entry was changed.
+    QueueEnabled,
+    /// A request is still in flight; no entry or redaction was changed.
+    InFlight,
+    /// The event type or exact raw content differs from the supplied original.
+    ContentMismatch,
+    /// The transaction is an upload or redaction rather than an event.
+    NotAnEvent,
+    /// The transaction still has dependent actions; they and their parent are retained.
+    DependentWork,
+}
