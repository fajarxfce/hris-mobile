+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn queued_original_preserves_unknown_fields_and_exact_bytes() {
+        let text = r#"{ "body":"é", "unknown": [1,2], "org.hris.message_id":"original" }"#;
+        let content = checked_queue_content(text.to_owned(), "m.room.message".to_owned()).unwrap();
+        let event = checked_queued_original("transaction".to_owned(), content).unwrap();
+        assert_eq!(event.content_json, text);
+        assert_eq!(event.event_type, "m.room.message");
+        assert_eq!(event.transaction_id, "transaction");
+        assert_eq!(format!("{event:?}"), "QueuedMessageEvent([redacted])");
+    }
+
+    #[test]
+    fn queued_original_rejects_non_objects_invalid_identifiers_and_utf8_overflow() {
+        for text in ["[]", "null", "true", "42", "\"private\"", "invalid"] {
+            assert!(checked_queue_content(text.to_owned(), "m.room.message".to_owned()).is_err());
+        }
+        for id in ["", "with space", "with\ncontrol"] {
+            assert!(check_queue_identifier(id).is_err());
+            assert!(checked_queue_content("{}".to_owned(), id.to_owned()).is_err());
+        }
+        assert!(check_queue_identifier(&"x".repeat(256)).is_err());
+        let json = format!("{{\"body\":\"{}\"}}", "é".repeat(MAX_QUEUE_EVENT_BYTES / 2));
+        assert!(json.chars().count() < MAX_QUEUE_EVENT_BYTES);
+        assert!(checked_queue_content(json, "m.room.message".to_owned()).is_err());
+    }
+
+    fn original(index: usize, bytes: usize) -> (OwnedTransactionId, SerializableEventContent) {
+        let json = format!(r#"{{"p":"{}"}}"#, "x".repeat(bytes - 8));
+        assert_eq!(json.len(), bytes);
+        (
+            OwnedTransactionId::from(format!("transaction-{index}")),
+            checked_queue_content(json, "m.room.message".to_owned()).unwrap(),
+        )
+    }
+
+    #[test]
+    fn queued_snapshot_bounds_count_and_rejects_duplicate_identity() {
+        assert!(checked_queue_originals(Vec::new()).unwrap().is_empty());
+        let items = (0..MAX_QUEUE_EVENTS).map(|i| original(i, 8)).collect();
+        assert_eq!(checked_queue_originals(items).unwrap().len(), MAX_QUEUE_EVENTS);
+        let items = (0..=MAX_QUEUE_EVENTS).map(|i| original(i, 8)).collect();
+        assert!(checked_queue_originals(items).is_err());
+        assert!(checked_queue_originals(vec![original(0, 8), original(0, 8)]).is_err());
+    }
+
+    #[test]
+    fn queued_snapshot_bounds_exact_utf8_bytes_per_event_and_in_total() {
+        let (_, content) = original(0, MAX_QUEUE_EVENT_BYTES);
+        assert_eq!(content.raw().0.json().get().len(), MAX_QUEUE_EVENT_BYTES);
+        let mut items: Vec<_> = (0..11).map(|i| original(i, 95_000)).collect();
+        items.push(original(11, MAX_QUEUE_SNAPSHOT_BYTES - 11 * 95_000));
+        assert_eq!(checked_queue_originals(items.clone()).unwrap().len(), 12);
+        items.push(original(12, 8));
+        assert!(checked_queue_originals(items).is_err());
+        let too_large = format!(r#"{{"p":"{}"}}"#, "x".repeat(MAX_QUEUE_EVENT_BYTES - 7));
+        assert!(checked_queue_content(too_large, "m.room.message".to_owned()).is_err());
+    }
+
+    #[tokio::test]
+    async fn queued_original_settlement_survives_sqlite_reopen_without_send_or_redaction() {
+        tokio::time::timeout(Duration::from_secs(20), async {
+            let server = matrix_sdk::test_utils::mocks::MatrixMockServer::new().await;
+            let directory = tempfile::tempdir().unwrap();
+            let id = ruma::room_id!("!queued:example.org");
+            let content = r#"{ "msgtype":"m.text", "body":"fictional", "unknown":[1,2] }"#;
+            let client = server
+                .client_builder()
+                .on_builder(|builder| builder.sqlite_store(directory.path(), None))
+                .build()
+                .await;
+            client.send_queue().set_enabled(false).await;
+            let sdk_room = server.sync_joined_room(&client, id).await;
+            let queue = sdk_room.send_queue();
+            let handle = queue
+                .send_raw(
+                    Raw::from_json(RawJsonValue::from_string(content.to_owned()).unwrap()),
+                    "m.room.message".to_owned(),
+                )
+                .await
+                .unwrap();
+            let transaction_id = handle.transaction_id().to_string();
+            drop(handle);
+            drop(queue);
+            let room = Room::new(sdk_room, None);
+            let originals = room.queued_message_events().await.unwrap();
+            assert_eq!(originals.len(), 1);
+            assert_eq!(originals[0].transaction_id, transaction_id);
+            assert_eq!(originals[0].content_json, content);
+            drop(room);
+            drop(client);
+
+            let restored = server
+                .client_builder()
+                .on_builder(|builder| builder.sqlite_store(directory.path(), None))
+                .build()
+                .await;
+            restored.send_queue().set_enabled(false).await;
+            let room = Room::new(restored.get_room(id).unwrap(), None);
+            let original = room.queued_message_events().await.unwrap().pop().unwrap();
+            assert_eq!(original.transaction_id, transaction_id);
+            assert_eq!(original.content_json, content);
+            for (event_type, json) in [("m.room.message", "{}"), ("org.example.other", content)] {
+                assert!(matches!(
+                    room.settle_confirmed_queue_event(
+                        transaction_id.clone(),
+                        event_type.to_owned(),
+                        json.to_owned(),
+                        "$confirmed".to_owned(),
+                    )
+                    .await
+                    .unwrap(),
+                    ConfirmedQueueEventResult::ContentMismatch
+                ));
+            }
+            assert!(
+                room.settle_confirmed_queue_event(
+                    transaction_id.clone(),
+                    "m.room.message".to_owned(),
+                    content.to_owned(),
+                    "invalid".to_owned(),
+                )
+                .await
+                .is_err()
+            );
+            assert_eq!(room.queued_message_events().await.unwrap().len(), 1);
+            assert!(matches!(
+                room.settle_confirmed_queue_event(
+                    transaction_id.clone(),
+                    "m.room.message".to_owned(),
+                    content.to_owned(),
+                    "$confirmed".to_owned(),
+                )
+                .await
+                .unwrap(),
+                ConfirmedQueueEventResult::Settled
+            ));
+            drop(room);
+            drop(restored);
+
+            let settled = server
+                .client_builder()
+                .on_builder(|builder| builder.sqlite_store(directory.path(), None))
+                .build()
+                .await;
+            settled.send_queue().set_enabled(false).await;
+            let room = Room::new(settled.get_room(id).unwrap(), None);
+            assert!(room.queued_message_events().await.unwrap().is_empty());
+            assert!(matches!(
+                room.settle_confirmed_queue_event(
+                    transaction_id,
+                    "m.room.message".to_owned(),
+                    content.to_owned(),
+                    "$confirmed".to_owned(),
+                )
+                .await
+                .unwrap(),
+                ConfirmedQueueEventResult::Missing
+            ));
+            let requests = server.server().received_requests().await.unwrap();
+            assert!(!requests.iter().any(|request| {
+                request.url.path().contains("/send/") || request.url.path().contains("/redact/")
+            }));
+        })
+        .await
+        .unwrap();
+    }
