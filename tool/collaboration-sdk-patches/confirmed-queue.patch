@@ -0,0 +1,324 @@
+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use matrix_sdk::send_queue::{ConfirmedEventSettlement, QueuedEventSnapshot};
+use matrix_sdk_base::store::SerializableEventContent;
+use ruma::{OwnedTransactionId, serde::Raw};
+use std::collections::HashSet;
+
+const MAX_QUEUE_EVENTS: usize = 128;
+const MAX_QUEUE_EVENT_BYTES: usize = 96_000;
+const MAX_QUEUE_SNAPSHOT_BYTES: usize = 1_048_576;
+
+/// Exact local event content from the paused native queue. It is not evidence
+/// that a server accepted the event. Callers must keep this private.
+#[derive(uniffi::Record)]
+pub struct QueuedMessageEvent {
+    pub transaction_id: String,
+    pub event_type: String,
+    pub content_json: String,
+}
+
+impl std::fmt::Debug for QueuedMessageEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("QueuedMessageEvent([redacted])")
+    }
+}
+
+/// No rejection removes a queue item or schedules a server redaction.
+#[derive(Debug, uniffi::Enum)]
+pub enum ConfirmedQueueEventResult {
+    Settled,
+    Missing,
+    QueueEnabled,
+    InFlight,
+    ContentMismatch,
+    NotAnEvent,
+    DependentWork,
+}
+
+impl From<ConfirmedEventSettlement> for ConfirmedQueueEventResult {
+    fn from(value: ConfirmedEventSettlement) -> Self {
+        match value {
+            ConfirmedEventSettlement::Settled => Self::Settled,
+            ConfirmedEventSettlement::Missing => Self::Missing,
+            ConfirmedEventSettlement::QueueEnabled => Self::QueueEnabled,
+            ConfirmedEventSettlement::InFlight => Self::InFlight,
+            ConfirmedEventSettlement::ContentMismatch => Self::ContentMismatch,
+            ConfirmedEventSettlement::NotAnEvent => Self::NotAnEvent,
+            ConfirmedEventSettlement::DependentWork => Self::DependentWork,
+        }
+    }
+}
+
+#[matrix_sdk_ffi_macros::export]
+impl Room {
+    /// Capture all original queued events while paused, with bounded count and
+    /// UTF-8 size. Unknown fields and exact JSON bytes are preserved. Mixed
+    /// upload/redaction queues are rejected rather than returned incompletely.
+    pub async fn queued_message_events(&self) -> Result<Vec<QueuedMessageEvent>, ClientError> {
+        let result: Result<Vec<QueuedMessageEvent>> = async {
+            let queue = self.inner.send_queue();
+            let QueuedEventSnapshot::Ready(originals) = queue.queued_event_contents().await? else {
+                anyhow::bail!("Original queue is not a quiescent standalone event queue");
+            };
+            checked_queue_originals(originals)
+        }
+        .await;
+        result.map_err(Into::into)
+    }
+
+    /// Settle externally verified server acceptance for exactly the captured
+    /// transaction, type and original JSON bytes. The caller owns authenticated
+    /// sender, room, device and server-event proof. This method does no network
+    /// I/O and never schedules a cancellation or redaction.
+    pub async fn settle_confirmed_queue_event(
+        &self,
+        transaction_id: String,
+        event_type: String,
+        content_json: String,
+        event_id: String,
+    ) -> Result<ConfirmedQueueEventResult, ClientError> {
+        check_queue_identifier(&transaction_id)?;
+        check_queue_identifier(&event_id)?;
+        let event_id = EventId::parse(event_id)?;
+        let transaction_id = OwnedTransactionId::from(transaction_id);
+        let original = checked_queue_content(content_json, event_type)?;
+        Ok(self
+            .inner
+            .send_queue()
+            .settle_confirmed_event(&transaction_id, &original, event_id)
+            .await
+            .map_err(anyhow::Error::from)?
+            .into())
+    }
+}
+
+fn checked_queue_originals(
+    originals: Vec<(OwnedTransactionId, SerializableEventContent)>,
+) -> Result<Vec<QueuedMessageEvent>> {
+    anyhow::ensure!(originals.len() <= MAX_QUEUE_EVENTS, "Original queue exceeds event limit");
+    let mut events = Vec::with_capacity(originals.len());
+    let mut seen = HashSet::with_capacity(originals.len());
+    let mut bytes = 0;
+    for (transaction_id, serialized_event) in originals {
+        let event = checked_queued_original(transaction_id.to_string(), serialized_event)?;
+        anyhow::ensure!(
+            seen.insert(event.transaction_id.clone()),
+            "Original queue repeats an identity"
+        );
+        bytes += event.content_json.len();
+        anyhow::ensure!(bytes <= MAX_QUEUE_SNAPSHOT_BYTES, "Original queue exceeds content limit");
+        events.push(event);
+    }
+    Ok(events)
+}
+
+fn check_queue_identifier(value: &str) -> Result<()> {
+    anyhow::ensure!(
+        !value.is_empty()
+            && value.len() <= 255
+            && !value.chars().any(|c| c.is_whitespace() || c.is_control()),
+        "Invalid original queue identifier"
+    );
+    Ok(())
+}
+
+fn checked_queue_content(json: String, event_type: String) -> Result<SerializableEventContent> {
+    check_queue_identifier(&event_type)?;
+    anyhow::ensure!(
+        json.len() <= MAX_QUEUE_EVENT_BYTES,
+        "Original queue event exceeds content limit"
+    );
+    let parsed: serde_json::Value = serde_json::from_str(&json)?;
+    anyhow::ensure!(parsed.is_object(), "Original queue event content must be an object");
+    Ok(SerializableEventContent::from_raw(
+        Raw::from_json(RawJsonValue::from_string(json)?),
+        event_type,
+    ))
+}
+
+fn checked_queued_original(
+    transaction_id: String,
+    content: SerializableEventContent,
+) -> Result<QueuedMessageEvent> {
+    check_queue_identifier(&transaction_id)?;
+    let (raw, event_type) = content.into_raw();
+    let content_json = raw.json().get().to_owned();
+    // Validate without replacing the captured bytes with a typed reconstruction.
+    checked_queue_content(content_json.clone(), event_type.clone())?;
+    Ok(QueuedMessageEvent { transaction_id, event_type, content_json })
+}
