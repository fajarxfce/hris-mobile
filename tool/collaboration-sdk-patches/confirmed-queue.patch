+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use crate::test_utils::logged_in_client;
+use matrix_sdk_test::{JoinedRoomBuilder, SyncResponseBuilder, async_test};
+use ruma::{event_id, room_id};
+
+async fn room() -> (Client, Room) {
+    let client = logged_in_client(None).await;
+    client.send_queue().set_enabled(false).await;
+    client
+        .base_client()
+        .receive_sync_response(
+            SyncResponseBuilder::new()
+                .add_joined_room(JoinedRoomBuilder::new(room_id!("!confirmed:example.org")))
+                .build_sync_response(),
+        )
+        .await
+        .unwrap();
+    let room = client.get_room(room_id!("!confirmed:example.org")).unwrap();
+    (client, room)
+}
+
+async fn queued(q: &RoomSendQueue) -> (OwnedTransactionId, SerializableEventContent) {
+    let raw = Raw::from_json(
+        serde_json::value::RawValue::from_string(
+            r#"{ "msgtype":"m.text", "body":"same", "org.hris.message_id":"original", "unknown":[1,2] }"#.to_owned(),
+        )
+        .unwrap(),
+    );
+    let content = SerializableEventContent::from_raw(raw.clone(), "m.room.message".to_owned());
+    let handle = q.send_raw(raw, "m.room.message".to_owned()).await.unwrap();
+    (handle.transaction_id().to_owned(), content)
+}
+
+#[async_test]
+async fn test_confirmed_settlement_removes_only_exact_transaction_and_publishes_one_local_ack() {
+    let (_client, room) = room().await;
+    let q = room.send_queue();
+    let (first, content) = queued(&q).await;
+    let (second, _) = queued(&q).await;
+    let QueuedEventSnapshot::Ready(originals) = q.queued_event_contents().await.unwrap() else {
+        panic!("Paused original queue was not readable");
+    };
+    assert_eq!(originals.len(), 2);
+    assert_eq!(originals[0].0, first);
+    assert_eq!(originals[1].0, second);
+    assert_eq!(originals[0].1.raw().0.json().get(), content.raw().0.json().get());
+    let (_, mut updates) = q.subscribe().await.unwrap();
+    assert_eq!(
+        q.settle_confirmed_event(&first, &content, event_id!("$confirmed").to_owned())
+            .await
+            .unwrap(),
+        ConfirmedEventSettlement::Settled
+    );
+    assert!(matches!(updates.try_recv().unwrap(), RoomSendQueueUpdate::SentEvent {
+        transaction_id, event_id
+    } if transaction_id == first && event_id == event_id!("$confirmed")));
+    let (remaining, _) = q.subscribe().await.unwrap();
+    assert_eq!(remaining.len(), 1);
+    assert_eq!(remaining[0].transaction_id, second);
+    assert_eq!(
+        q.settle_confirmed_event(&first, &content, event_id!("$confirmed").to_owned())
+            .await
+            .unwrap(),
+        ConfirmedEventSettlement::Missing
+    );
+    assert!(matches!(updates.try_recv(), Err(broadcast::error::TryRecvError::Empty)));
+    assert!(!q.is_enabled());
+}
+
+#[async_test]
+async fn test_confirmed_settlement_rejects_type_bytes_and_unknown_transaction() {
+    let (_client, room) = room().await;
+    let q = room.send_queue();
+    let (transaction, original) = queued(&q).await;
+    let (raw, _) = original.raw();
+    let wrong_type =
+        SerializableEventContent::from_raw(raw.clone(), "org.example.other".to_owned());
+    let changed =
+        SerializableEventContent::new(&RoomMessageEventContent::text_plain("changed").into())
+            .unwrap();
+    let semantic_rewrite = SerializableEventContent::from_raw(
+        Raw::from_json(
+            serde_json::value::RawValue::from_string(
+                serde_json::from_str::<serde_json::Value>(raw.json().get()).unwrap().to_string(),
+            )
+            .unwrap(),
+        ),
+        "m.room.message".to_owned(),
+    );
+    for content in [wrong_type, changed, semantic_rewrite] {
+        assert_eq!(
+            q.settle_confirmed_event(&transaction, &content, event_id!("$confirmed").to_owned())
+                .await
+                .unwrap(),
+            ConfirmedEventSettlement::ContentMismatch
+        );
+    }
+    assert_eq!(
+        q.settle_confirmed_event(
+            &TransactionId::new(),
+            &original,
+            event_id!("$confirmed").to_owned()
+        )
+        .await
+        .unwrap(),
+        ConfirmedEventSettlement::Missing
+    );
+    assert_eq!(q.subscribe().await.unwrap().0.len(), 1);
+}
+
+#[async_test]
+async fn test_confirmed_settlement_does_not_cancel_in_flight_work_or_create_redactions() {
+    let (client, room) = room().await;
+    let q = room.send_queue();
+    let (transaction, original) = queued(&q).await;
+    *q.inner.queue.store.lock().await.being_sent =
+        Some(BeingSentInfo { transaction_id: transaction.clone(), cancel_upload: None });
+    assert_eq!(
+        q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned())
+            .await
+            .unwrap(),
+        ConfirmedEventSettlement::InFlight
+    );
+    assert!(matches!(q.queued_event_contents().await.unwrap(), QueuedEventSnapshot::InFlight));
+    assert!(
+        client
+            .state_store()
+            .load_dependent_queued_requests(room.room_id())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+    assert_eq!(q.subscribe().await.unwrap().0.len(), 1);
+    let mut guard = q.inner.queue.store.lock().await;
+    assert_eq!(guard.being_sent.as_ref().unwrap().transaction_id, transaction);
+    *guard.being_sent = None;
+}
+
+#[async_test]
+async fn test_confirmed_settlement_rejects_an_enabled_queue_without_removing_work() {
+    let (_client, room) = room().await;
+    let q = room.send_queue();
+    let (transaction, original) = queued(&q).await;
+    // Retain the store lock so even a faulty background enable cannot start a request.
+    let guard = q.inner.queue.store.lock().await;
+    q.set_enabled(true);
+    assert_eq!(
+        q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned())
+            .await
+            .unwrap(),
+        ConfirmedEventSettlement::QueueEnabled
+    );
+    assert!(matches!(q.queued_event_contents().await.unwrap(), QueuedEventSnapshot::QueueEnabled));
+    q.set_enabled(false);
+    drop(guard);
+    assert_eq!(q.subscribe().await.unwrap().0.len(), 1);
+}
+
+#[async_test]
+async fn test_confirmed_settlement_preserves_dependent_actions_and_their_parent() {
+    let (client, room) = room().await;
+    let q = room.send_queue();
+    let (transaction, original) = queued(&q).await;
+    client
+        .state_store()
+        .save_dependent_queued_request(
+            room.room_id(),
+            &transaction,
+            ChildTransactionId::new(),
+            MilliSecondsSinceUnixEpoch::now(),
+            DependentQueuedRequestKind::RedactEvent,
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned())
+            .await
+            .unwrap(),
+        ConfirmedEventSettlement::DependentWork
+    );
+    assert!(matches!(q.queued_event_contents().await.unwrap(), QueuedEventSnapshot::DependentWork));
+    assert_eq!(q.subscribe().await.unwrap().0.len(), 1);
+    assert_eq!(
+        client.state_store().load_dependent_queued_requests(room.room_id()).await.unwrap().len(),
+        1
+    );
+}
+
+#[async_test]
+async fn test_confirmed_settlement_does_not_remove_a_native_redaction() {
+    let (_client, room) = room().await;
+    let q = room.send_queue();
+    let (_, original) = queued(&q).await;
+    let handle = q.redact(event_id!("$redacted").to_owned(), None).await.unwrap();
+    assert_eq!(
+        q.settle_confirmed_event(
+            handle.transaction_id(),
+            &original,
+            event_id!("$confirmed").to_owned()
+        )
+        .await
+        .unwrap(),
+        ConfirmedEventSettlement::NotAnEvent
+    );
+    assert!(matches!(q.queued_event_contents().await.unwrap(), QueuedEventSnapshot::NotAnEvent));
+    assert_eq!(q.subscribe().await.unwrap().0.len(), 2);
+}
+
+#[async_test]
+async fn test_concurrent_confirmed_settlements_publish_once() {
+    let (_client, room) = room().await;
+    let q = room.send_queue();
+    let (transaction, original) = queued(&q).await;
+    let (_, mut updates) = q.subscribe().await.unwrap();
+    let (first, second) = tokio::join!(
+        q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned()),
+        q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned()),
+    );
+    let results = [first.unwrap(), second.unwrap()];
+    assert_eq!(results.iter().filter(|r| **r == ConfirmedEventSettlement::Settled).count(), 1);
+    assert_eq!(results.iter().filter(|r| **r == ConfirmedEventSettlement::Missing).count(), 1);
+    assert!(matches!(updates.try_recv().unwrap(), RoomSendQueueUpdate::SentEvent { .. }));
+    assert!(matches!(updates.try_recv(), Err(broadcast::error::TryRecvError::Empty)));
+    assert!(q.subscribe().await.unwrap().0.is_empty());
+}
+
+#[async_test]
+async fn test_cancelled_settlement_waiter_preserves_original_and_allows_later_recovery() {
+    let (_client, room) = room().await;
+    let q = room.send_queue();
+    let (transaction, original) = queued(&q).await;
+    let (_, mut updates) = q.subscribe().await.unwrap();
+    let guard = q.inner.queue.store.lock().await;
+    assert!(
+        tokio::time::timeout(
+            Duration::from_millis(25),
+            q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned())
+        )
+        .await
+        .is_err()
+    );
+    drop(guard);
+    assert_eq!(q.subscribe().await.unwrap().0.len(), 1);
+    assert!(matches!(updates.try_recv(), Err(broadcast::error::TryRecvError::Empty)));
+    assert_eq!(
+        q.settle_confirmed_event(&transaction, &original, event_id!("$confirmed").to_owned())
+            .await
+            .unwrap(),
+        ConfirmedEventSettlement::Settled
+    );
+}
