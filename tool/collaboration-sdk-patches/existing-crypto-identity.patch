+#[tokio::test]
+async fn wrong_passphrase_corruption_and_missing_cipher_never_replace_the_account() {
+    let (dir, _) = retained().await;
+    let path = dir.path().join(DATABASE_NAME);
+    let before = fs::read(&path).unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), "wrong"),
+        Err(ExistingCryptoStoreError::Cipher(_))
+    ));
+    assert_eq!(before, fs::read(&path).unwrap());
+    let conn = Connection::open(&path).unwrap();
+    conn.execute("UPDATE kv SET value = ? WHERE key = 'account'", [b"corrupt".as_slice()]).unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+        Err(ExistingCryptoStoreError::Account(_))
+    ));
+    conn.execute("DELETE FROM kv WHERE key = 'cipher'", []).unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+        Err(ExistingCryptoStoreError::InvalidStore)
+    ));
+    assert_eq!(
+        conn.query_row("SELECT count(*) FROM kv WHERE key = 'cipher'", [], |r| r.get::<_, i64>(0))
+            .unwrap(),
+        0
+    );
+    assert_eq!(
+        conn.query_row("SELECT value FROM kv WHERE key = 'account'", [], |r| r
+            .get::<_, Vec<u8>>(0))
+            .unwrap(),
+        b"corrupt"
+    );
+}
