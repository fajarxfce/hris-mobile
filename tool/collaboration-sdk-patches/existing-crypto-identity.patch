+#[tokio::test]
+async fn missing_private_account_is_not_initialized() {
+    let dir = tempfile::tempdir().unwrap();
+    let store = SqliteCryptoStore::open(dir.path(), Some(PASSPHRASE)).await.unwrap();
+    store.close().await.unwrap();
+    let before = fs::read(dir.path().join(DATABASE_NAME)).unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+        Err(ExistingCryptoStoreError::InvalidStore)
+    ));
+    assert_eq!(before, fs::read(dir.path().join(DATABASE_NAME)).unwrap());
+    store.reopen().await.unwrap();
+    assert!(store.load_account().await.unwrap().is_none());
+    store.close().await.unwrap();
+}
