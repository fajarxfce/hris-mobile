+const PASSPHRASE: &str = "local-inventory-test-passphrase";
+
+async fn retained() -> (TempDir, ExistingCryptoStoreIdentity) {
+    let dir = tempfile::tempdir().unwrap();
+    let account =
+        Account::with_device_id(user_id!("@fixture:example.test"), device_id!("ORIGINAL"));
+    let keys = account.identity_keys();
+    let expected = ExistingCryptoStoreIdentity {
+        user_id: account.user_id().to_string(),
+        device_id: account.device_id().to_string(),
+        ed25519_key: keys.ed25519.to_base64(),
+        curve25519_key: keys.curve25519.to_base64(),
+    };
+    let store = SqliteCryptoStore::open(dir.path(), Some(PASSPHRASE)).await.unwrap();
+    store.save_pending_changes(PendingChanges { account: Some(account) }).await.unwrap();
+    store.close().await.unwrap();
+    (dir, expected)
+}
