+#[tokio::test]
+async fn existing_private_account_matches_without_mutating_the_database() {
+    let (dir, expected) = retained().await;
+    let before = fs::read(dir.path().join(DATABASE_NAME)).unwrap();
+    for _ in 0..2 {
+        assert_eq!(read_existing_crypto_store_identity(dir.path(), PASSPHRASE).unwrap(), expected);
+    }
+    assert_eq!(before, fs::read(dir.path().join(DATABASE_NAME)).unwrap());
+    assert!(!format!("{expected:?}").contains(&expected.user_id));
+    let store = SqliteCryptoStore::open(dir.path(), Some(PASSPHRASE)).await.unwrap();
+    assert_eq!(
+        store.load_account().await.unwrap().unwrap().identity_keys().ed25519.to_base64(),
+        expected.ed25519_key
+    );
+    store.close().await.unwrap();
+}
+
+#[test]
+fn absent_empty_and_redirected_database_is_never_created_or_repaired() {
+    let dir = tempfile::tempdir().unwrap();
+    let absent = dir.path().join("absent");
+    assert!(read_existing_crypto_store_identity(&absent, PASSPHRASE).is_err());
+    assert!(!absent.exists());
+    let file = dir.path().join(DATABASE_NAME);
+    fs::write(&file, []).unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+        Err(ExistingCryptoStoreError::InvalidStore)
+    ));
+    assert_eq!(fs::metadata(&file).unwrap().len(), 0);
+    fs::remove_file(&file).unwrap();
+    #[cfg(unix)]
+    {
+        let target = dir.path().join("retained");
+        fs::write(&target, "unchanged").unwrap();
+        std::os::unix::fs::symlink(&target, &file).unwrap();
+        assert!(matches!(
+            read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+            Err(ExistingCryptoStoreError::InvalidStore)
+        ));
+        assert_eq!(fs::read_to_string(target).unwrap(), "unchanged");
+    }
+}
