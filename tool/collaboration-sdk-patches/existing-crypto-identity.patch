+#[tokio::test]
+async fn unsupported_schema_and_oversized_records_fail_without_migrating() {
+    let (dir, _) = retained().await;
+    let conn = Connection::open(dir.path().join(DATABASE_NAME)).unwrap();
+    conn.execute(
+        "UPDATE kv SET value = ? WHERE key = 'version'",
+        [[DATABASE_VERSION + 1].as_slice()],
+    )
+    .unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+        Err(ExistingCryptoStoreError::UnsupportedVersion)
+    ));
+    assert_eq!(
+        conn.query_row("SELECT value FROM kv WHERE key = 'version'", [], |r| r
+            .get::<_, Vec<u8>>(0))
+            .unwrap(),
+        [DATABASE_VERSION + 1]
+    );
+    conn.execute("UPDATE kv SET value = ? WHERE key = 'version'", [[DATABASE_VERSION].as_slice()])
+        .unwrap();
+    conn.execute("UPDATE kv SET value = zeroblob(65537) WHERE key = 'cipher'", []).unwrap();
+    assert!(matches!(
+        read_existing_crypto_store_identity(dir.path(), PASSPHRASE),
+        Err(ExistingCryptoStoreError::InvalidStore)
+    ));
+}
+
+#[tokio::test]
+async fn reader_includes_committed_wal_but_not_an_uncommitted_replacement() {
+    let (dir, original) = retained().await;
+    let mut writer = Connection::open(dir.path().join(DATABASE_NAME)).unwrap();
+    writer.pragma_update(None, "journal_mode", "WAL").unwrap();
+    writer.pragma_update(None, "wal_autocheckpoint", 0).unwrap();
+    let exported: Vec<u8> =
+        writer.query_row("SELECT value FROM kv WHERE key = 'cipher'", [], |r| r.get(0)).unwrap();
+    let cipher = ExistingCipher(StoreCipher::import(PASSPHRASE, &exported).unwrap());
+    let changed = Account::with_device_id(user_id!("@fixture:example.test"), device_id!("SECOND"));
+    let encoded = cipher.serialize_value(&changed.pickle()).unwrap();
+    let transaction = writer.transaction().unwrap();
+    transaction.execute("UPDATE kv SET value = ? WHERE key = 'account'", params![encoded]).unwrap();
+    assert_eq!(read_existing_crypto_store_identity(dir.path(), PASSPHRASE).unwrap(), original);
+    transaction.commit().unwrap();
+    assert!(fs::metadata(dir.path().join(format!("{DATABASE_NAME}-wal"))).unwrap().len() > 0);
+    let actual = read_existing_crypto_store_identity(dir.path(), PASSPHRASE).unwrap();
+    assert_eq!(actual.device_id, "SECOND");
+    assert_eq!(actual.ed25519_key, changed.identity_keys().ed25519.to_base64());
+    assert_ne!(actual.ed25519_key, original.ed25519_key);
+}
