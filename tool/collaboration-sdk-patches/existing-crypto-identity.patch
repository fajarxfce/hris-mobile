+// Copyright 2026 The Matrix.org Foundation C.I.C.
+// SPDX-License-Identifier: Apache-2.0
+
+use matrix_sdk_sqlite::{ExistingCryptoStoreError, read_existing_crypto_store_identity};
+use zeroize::Zeroizing;
+
+/// Identity from the retained private Olm account, with no token or private-key fields.
+#[derive(uniffi::Record)]
+pub struct ExistingCryptoIdentity {
+    pub user_id: String,
+    pub device_id: String,
+    pub ed25519_key: String,
+    pub curve25519_key: String,
+}
+
+/// Closed categories deliberately omit paths, stored records and raw exception messages.
+#[derive(Debug, thiserror::Error, uniffi::Error)]
+pub enum ExistingCryptoIdentityError {
+    #[error("Existing crypto store is unavailable")]
+    Unavailable,
+    #[error("Existing crypto store is incomplete or invalid")]
+    InvalidStore,
+    #[error("Existing crypto store requires a compatible reader")]
+    UnsupportedVersion,
+}
+
+/// Blocking local read; call off the UI thread while owning the SDK directory lock.
+/// It never constructs a client, restores a session, creates keys or accesses a server.
+#[matrix_sdk_ffi_macros::export]
+pub fn read_existing_crypto_identity(
+    database_directory: String,
+    passphrase: String,
+) -> Result<ExistingCryptoIdentity, ExistingCryptoIdentityError> {
+    let passphrase = Zeroizing::new(passphrase);
+    let identity =
+        read_existing_crypto_store_identity(database_directory, &passphrase).map_err(|error| {
+            match error {
+                ExistingCryptoStoreError::Io(_) | ExistingCryptoStoreError::Sqlite(_) => {
+                    ExistingCryptoIdentityError::Unavailable
+                }
+                ExistingCryptoStoreError::UnsupportedVersion => {
+                    ExistingCryptoIdentityError::UnsupportedVersion
+                }
+                _ => ExistingCryptoIdentityError::InvalidStore,
+            }
+        })?;
+    Ok(ExistingCryptoIdentity {
+        user_id: identity.user_id,
+        device_id: identity.device_id,
+        ed25519_key: identity.ed25519_key,
+        curve25519_key: identity.curve25519_key,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use matrix_sdk::ruma::{device_id, user_id};
+    use matrix_sdk_base::crypto::{
+        Account,
+        store::{CryptoStore, types::PendingChanges},
+    };
+    use matrix_sdk_sqlite::SqliteCryptoStore;
+
+    #[tokio::test]
+    async fn ffi_returns_only_the_original_identity_and_closed_failure_categories() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().to_string_lossy().into_owned();
+        assert!(matches!(
+            read_existing_crypto_identity(path.clone(), "fixture".into()),
+            Err(ExistingCryptoIdentityError::Unavailable)
+        ));
+        assert_eq!(std::fs::read_dir(directory.path()).unwrap().count(), 0);
+        let account =
+            Account::with_device_id(user_id!("@fixture:example.test"), device_id!("RETAINED"));
+        let keys = account.identity_keys();
+        let store = SqliteCryptoStore::open(directory.path(), Some("fixture")).await.unwrap();
+        store.save_pending_changes(PendingChanges { account: Some(account) }).await.unwrap();
+        store.close().await.unwrap();
+        let identity = read_existing_crypto_identity(path.clone(), "fixture".into()).unwrap();
+        assert_eq!(identity.user_id, "@fixture:example.test");
+        assert_eq!(identity.device_id, "RETAINED");
+        assert_eq!(identity.ed25519_key, keys.ed25519.to_base64());
+        assert_eq!(identity.curve25519_key, keys.curve25519.to_base64());
+        assert!(matches!(
+            read_existing_crypto_identity(path, "wrong".into()),
+            Err(ExistingCryptoIdentityError::InvalidStore)
+        ));
+    }
+}
