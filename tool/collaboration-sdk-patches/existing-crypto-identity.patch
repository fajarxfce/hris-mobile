+use std::{fmt, fs, path::Path, time::Duration};
+
+use matrix_sdk_crypto::Account;
+use matrix_sdk_store_encryption::StoreCipher;
+use rusqlite::{Connection, OpenFlags, OptionalExtension, limits::Limit};
+use zeroize::Zeroizing;
