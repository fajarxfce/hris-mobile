+use super::{DATABASE_NAME, DATABASE_VERSION};
+use crate::utils::EncryptableStore;
+
+/// Public identity derived from the private Olm account in an existing encrypted store.
+/// This does not establish live server admission or verification by another device.
+#[derive(Clone, PartialEq, Eq)]
+pub struct ExistingCryptoStoreIdentity {
+    /// Stored Matrix account ID.
+    pub user_id: String,
+    /// Stored Matrix device ID.
+    pub device_id: String,
+    /// Public Ed25519 key derived from the retained private account.
+    pub ed25519_key: String,
+    /// Public Curve25519 key derived from the retained private account.
+    pub curve25519_key: String,
+}
+
+impl fmt::Debug for ExistingCryptoStoreIdentity {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("ExistingCryptoStoreIdentity([redacted])")
+    }
+}
+
+/// Inspection failures never authorize creating a store or account.
+#[derive(Debug, thiserror::Error)]
+pub enum ExistingCryptoStoreError {
+    /// Cannot inspect the existing file.
+    #[error("Cannot inspect the existing crypto store")]
+    Io(#[from] std::io::Error),
+    /// The path or record is incomplete, invalid, redirected or outside its byte bounds.
+    #[error("Existing crypto store is incomplete or invalid")]
+    InvalidStore,
+    /// Inspection supports the current schema without migrating it.
+    #[error("Existing crypto store needs a compatible schema reader")]
+    UnsupportedVersion,
+    /// Existing SQLite read failed.
+    #[error("Cannot read the existing crypto store")]
+    Sqlite(#[from] rusqlite::Error),
+    /// Cannot decrypt the original cipher export within the work bound.
+    #[error("Cannot open the retained store cipher")]
+    Cipher(#[from] matrix_sdk_store_encryption::Error),
+    /// Cannot deserialize or unpickle the original private account.
+    #[error("Cannot decode the retained private account")]
+    Account(#[source] Box<dyn std::error::Error + Send + Sync>),
+}
+
+struct ExistingCipher(StoreCipher);
+impl EncryptableStore for ExistingCipher {
+    fn get_cypher(&self) -> Option<&StoreCipher> {
+        Some(&self.0)
+    }
+}
+
+/// Synchronously inspect an existing encrypted private account without opening a client,
+/// creating files/accounts/ciphers, migrating, checkpointing or sending network requests.
+/// The caller must own its exclusive SDK directory lease and invoke this off the UI thread.
+/// A read transaction includes committed WAL content; do not use SQLite immutable mode.
+/// SQLite may manage its existing WAL shared-memory bookkeeping while opening a reader.
+/// Missing/corrupt stores return errors, not an enrollment or recovery decision.
+pub fn read_existing_crypto_store_identity(
+    directory: impl AsRef<Path>,
+    passphrase: &str,
+) -> Result<ExistingCryptoStoreIdentity, ExistingCryptoStoreError> {
+    if passphrase.len() > 4096 {
+        return Err(ExistingCryptoStoreError::InvalidStore);
+    }
+    let path = directory.as_ref().join(DATABASE_NAME);
+    let metadata = fs::symlink_metadata(&path)?;
+    if !metadata.is_file() || metadata.len() == 0 {
+        return Err(ExistingCryptoStoreError::InvalidStore);
+    }
+    let mut connection = Connection::open_with_flags(
+        &path,
+        OpenFlags::SQLITE_OPEN_READ_ONLY
+            | OpenFlags::SQLITE_OPEN_NO_MUTEX
+            | OpenFlags::SQLITE_OPEN_NOFOLLOW,
+    )?;
+    connection.busy_timeout(Duration::from_millis(250))?;
+    connection.set_limit(Limit::SQLITE_LIMIT_LENGTH, 8 * 1024 * 1024)?;
+    let transaction = connection.transaction()?;
+    let version = required_record(&transaction, "version", 1)?;
+    if version.as_slice() != [DATABASE_VERSION] {
+        return Err(ExistingCryptoStoreError::UnsupportedVersion);
+    }
+    let export = required_record(&transaction, "cipher", 65_536)?;
+    let cipher =
+        ExistingCipher(StoreCipher::import_with_max_rounds(passphrase, &export, 1_000_000)?);
+    let account = required_record(&transaction, "account", 8 * 1024 * 1024)?;
+    // Reuse the SDK's encrypted value and pickle codec. No alternative key representation.
+    let pickle = cipher
+        .deserialize_value(&account)
+        .map_err(|error| ExistingCryptoStoreError::Account(Box::new(error)))?;
+    let account = Account::from_pickle(pickle)
+        .map_err(|error| ExistingCryptoStoreError::Account(Box::new(error)))?;
+    let identity = account.identity_keys();
+    Ok(ExistingCryptoStoreIdentity {
+        user_id: account.user_id().to_string(),
+        device_id: account.device_id().to_string(),
+        ed25519_key: identity.ed25519.to_base64(),
+        curve25519_key: identity.curve25519.to_base64(),
+    })
+}
+
+fn required_record(
+    connection: &Connection,
+    key: &str,
+    maximum: usize,
+) -> Result<Zeroizing<Vec<u8>>, ExistingCryptoStoreError> {
+    let size: Option<i64> = connection
+        .query_row("SELECT length(value) FROM kv WHERE key = ?", [key], |row| row.get(0))
+        .optional()?;
+    if !size.is_some_and(|n| n > 0 && n <= maximum as i64) {
+        return Err(ExistingCryptoStoreError::InvalidStore);
+    }
+    Ok(Zeroizing::new(connection.query_row(
+        "SELECT value FROM kv WHERE key = ?",
+        [key],
+        |row| row.get(0),
+    )?))
+}
