+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+use futures_util::FutureExt;
+
+use super::*;
+
+fn request() -> reqwest::Request {
+    reqwest::Client::new().get("https://example.test/_matrix/client/versions").build().unwrap()
+}
+
+#[test]
+fn disabled_registry_does_not_create_an_attempt() {
+    let registry = HttpObservationRegistry::default();
+    assert!(registry.begin(&request(), 1).is_none());
+    assert_eq!(registry.next_id.load(Ordering::Relaxed), 0);
+}
+
+#[tokio::test]
+async fn metadata_is_bounded_before_buffering_and_excludes_credentials() {
+    let registry = HttpObservationRegistry::default();
+    let subscription = registry.subscribe();
+    let path = "x".repeat(100_000);
+    let query = (0..100).map(|i| format!("name{i}=private-query")).collect::<Vec<_>>().join("&");
+    let request = reqwest::Client::new()
+        .get(format!("https://private-user:private-password@example.test/{path}?{query}"))
+        .header("authorization", "Bearer private-token")
+        .header("cookie", "private-cookie")
+        .build()
+        .unwrap();
+    let mut attempt = registry.begin(&request, 1).unwrap();
+    attempt.finish(Some(23), None);
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.events.len(), 2);
+    let HttpObservationEvent::Started { request, .. } = &batch.events[0] else { panic!() };
+    assert_eq!(request.host, "example.test");
+    assert_eq!(request.path.len(), 1024);
+    assert_eq!(request.query_names.len(), 32);
+    assert_eq!(request.query_names[0], "name0");
+    assert!(request.truncated);
+    assert!(request.header_names.contains(&"authorization".to_owned()));
+    assert!(!format!("{batch:?}").contains("private-"));
+}
+
+#[tokio::test]
+async fn replacement_erases_old_queue_and_fences_inflight_completions() {
+    let registry = HttpObservationRegistry::default();
+    let old = registry.subscribe();
+    let mut original = registry.begin(&request(), 1).unwrap();
+    let replacement = registry.subscribe();
+    original.finish(Some(10), None);
+    let closed = old.next_batch().await;
+    assert!(closed.closed);
+    assert!(closed.events.is_empty());
+    assert!(replacement.next_batch().now_or_never().is_none());
+    let mut next = registry.begin(&request(), 1).unwrap();
+    next.finish(Some(11), None);
+    let batch = replacement.next_batch().await;
+    assert_eq!(batch.events.len(), 2);
+    assert!(matches!(
+        batch.events[1],
+        HttpObservationEvent::Finished { response_bytes: Some(11), .. }
+    ));
+}
+
+#[tokio::test]
+async fn dropped_attempt_is_cancelled_not_successful() {
+    let registry = HttpObservationRegistry::default();
+    let subscription = registry.subscribe();
+    drop(registry.begin(&request(), 2));
+    let batch = subscription.next_batch().await;
+    assert!(matches!(batch.events[0], HttpObservationEvent::Started { attempt: 2, .. }));
+    assert!(matches!(
+        batch.events[1],
+        HttpObservationEvent::Finished {
+            response_bytes: None,
+            failure: Some(HttpObservedFailure::Cancelled),
+            ..
+        }
+    ));
+}
+
+#[tokio::test]
+async fn slow_reader_is_bounded_and_reports_loss_instead_of_waiting() {
+    let registry = HttpObservationRegistry::default();
+    let subscription = registry.subscribe();
+    for _ in 0..CAPACITY {
+        if let Some(mut attempt) = registry.begin(&request(), 1) {
+            attempt.finish(Some(1), None);
+        }
+    }
+    assert_eq!(subscription.queue.state.lock().unwrap().events.len(), CAPACITY);
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.events.len(), BATCH_SIZE);
+    assert_eq!(batch.dropped_events, CAPACITY as u64 / 2);
+    subscription.close();
+    let batch = subscription.next_batch().await;
+    assert!(batch.closed);
+    assert!(batch.events.is_empty());
+}
+
+#[tokio::test]
+async fn canceled_read_does_not_consume_and_close_wakes_registered_reader() {
+    let registry = HttpObservationRegistry::default();
+    let subscription = registry.subscribe();
+    assert!(subscription.next_batch().now_or_never().is_none());
+    let read = subscription.next_batch();
+    tokio::pin!(read);
+    assert!(read.as_mut().now_or_never().is_none());
+    subscription.close();
+    let batch = read.await;
+    assert!(batch.closed);
+    assert!(batch.events.is_empty());
+    assert!(registry.begin(&request(), 1).is_none());
+}
+
+#[tokio::test]
+async fn busy_reader_and_registry_never_block_http_producer() {
+    let registry = HttpObservationRegistry::default();
+    let subscription = registry.subscribe();
+    {
+        let _held = subscription.queue.state.lock().unwrap();
+        assert!(registry.begin(&request(), 1).is_none());
+    }
+    {
+        let _held = registry.current.lock().unwrap();
+        assert!(registry.begin(&request(), 1).is_none());
+    }
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.dropped_events, 1);
+    assert_eq!(batch.missed_attempt_starts, 1);
+    assert!(batch.events.is_empty());
+}
+
+#[test]
+fn string_bounds_keep_utf8_valid() {
+    let mut truncated = false;
+    assert_eq!(bounded("a🦀z", 4, &mut truncated), "a");
+    assert!(truncated);
+}
+
+#[tokio::test]
+async fn dropping_client_registry_erases_capture_and_releases_reader() {
+    let registry = HttpObservationRegistry::default();
+    let subscription = registry.subscribe();
+    let original = registry.begin(&request(), 1).unwrap();
+    drop(registry);
+    drop(original);
+    let batch = subscription.next_batch().await;
+    assert!(batch.closed);
+    assert!(batch.events.is_empty());
+}
