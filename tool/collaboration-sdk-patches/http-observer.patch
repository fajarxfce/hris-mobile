diff --git a/crates/matrix-sdk/src/http_observer.rs b/crates/matrix-sdk/src/http_observer.rs
new file mode 100644
index 0000000..469fda8
--- /dev/null
+++ b/crates/matrix-sdk/src/http_observer.rs
@@ -0,0 +1,440 @@
+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Optional bounded metadata observation of SDK HTTP attempts.
+//!
+//! No body, URL credentials, query value or header value enters this channel. A
+//! slow reader loses observations, never delays the HTTP transport. Request IDs
+//! are diagnostic IDs, not Matrix event or transaction IDs.
+
+use std::{
+    collections::VecDeque,
+    fmt,
+    sync::{
+        Arc, Mutex, Weak,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+};
+
+use ruma::{MilliSecondsSinceUnixEpoch, time::Instant};
+use tokio::sync::Notify;
+
+const CAPACITY: usize = 256;
+const BATCH_SIZE: usize = 32;
+
+/// Sanitized metadata captured immediately before executing an HTTP attempt.
+#[derive(Clone)]
+pub struct HttpObservedRequest {
+    /// HTTP method, at most 16 bytes.
+    pub method: String,
+    /// Parsed URL scheme, at most 16 bytes.
+    pub scheme: String,
+    /// Parsed host without URL credentials, at most 253 bytes.
+    pub host: String,
+    /// Explicit or protocol-default port.
+    pub port: Option<u16>,
+    /// Encoded path, at most 1024 bytes. Endpoint-specific path data remains visible.
+    pub path: String,
+    /// At most 32 encoded query names of at most 64 bytes each. No values.
+    pub query_names: Vec<String>,
+    /// At most 32 header names of at most 64 bytes each. No values.
+    pub header_names: Vec<String>,
+    /// Whether any field exceeded observation limits.
+    pub truncated: bool,
+}
+
+impl fmt::Debug for HttpObservedRequest {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("HttpObservedRequest([redacted])")
+    }
+}
+
+/// A transport failure category without the potentially sensitive error string.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HttpObservedFailure {
+    /// The request timed out.
+    Timeout,
+    /// Connection establishment failed; no unverified DNS/TLS distinction is inferred.
+    Connection,
+    /// The caller dropped the in-flight future.
+    Cancelled,
+    /// Another transport/body error occurred.
+    Other,
+}
+
+/// One stage of a real HTTP attempt. Headers and body completion are separate.
+#[derive(Clone, Debug)]
+pub enum HttpObservationEvent {
+    /// An SDK attempt is about to enter the HTTP engine.
+    Started {
+        /// Diagnostic identity shared by this attempt's observations.
+        id: u64,
+        /// One-based SDK retry attempt; engine-internal redirects are not counted.
+        attempt: u64,
+        /// Wall-clock start time captured at the transport boundary.
+        started_at_epoch_millis: u64,
+        /// Bounded request metadata.
+        request: HttpObservedRequest,
+    },
+    /// Real response headers arrived; a later body failure does not erase this status.
+    Response {
+        /// Diagnostic attempt identity.
+        id: u64,
+        /// Actual HTTP status.
+        status: u16,
+        /// Monotonic time to headers.
+        elapsed_millis: u64,
+        /// Bounded header names, with all values excluded.
+        header_names: Vec<String>,
+        /// Whether header names exceeded observation limits.
+        truncated: bool,
+    },
+    /// The existing response-body conversion finished or the future ended.
+    Finished {
+        /// Diagnostic attempt identity.
+        id: u64,
+        /// Monotonic time to termination.
+        elapsed_millis: u64,
+        /// Bytes actually read by the original body consumer, if it completed.
+        response_bytes: Option<u64>,
+        /// None means transport/body completion, not a successful Matrix operation.
+        failure: Option<HttpObservedFailure>,
+    },
+}
+
+/// A bounded batch. Counters are cumulative within this subscription.
+#[derive(Debug)]
+pub struct HttpObservationBatch {
+    /// At most 32 observations in producer order.
+    pub events: Vec<HttpObservationEvent>,
+    /// Dropped events caused by a full queue or momentary queue contention.
+    pub dropped_events: u64,
+    /// Attempts whose subscription could not be acquired without waiting.
+    pub missed_attempt_starts: u64,
+    /// Closing erases queued observations and wakes pending readers.
+    pub closed: bool,
+}
+
+/// The caller owns the subscription. Close it on account change or collector disposal.
+///
+/// Creating a replacement closes the previous subscription. Old in-flight attempts
+/// keep their original generation and cannot write into the replacement.
+pub struct HttpObservationSubscription {
+    queue: Arc<Queue>,
+}
+
+impl fmt::Debug for HttpObservationSubscription {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("HttpObservationSubscription([redacted])")
+    }
+}
+
+impl HttpObservationSubscription {
+    /// Wait for a bounded batch. Canceling a suspended read does not consume observations.
+    /// A single owning collector should call this method until the batch is closed.
+    pub async fn next_batch(&self) -> HttpObservationBatch {
+        loop {
+            // Register before inspecting the queue to avoid losing an intervening wake.
+            let ready = self.queue.ready.notified();
+            tokio::pin!(ready);
+            ready.as_mut().enable();
+            {
+                let mut state = self.queue.state.lock().unwrap_or_else(|e| e.into_inner());
+                let dropped = self.queue.dropped.load(Ordering::Relaxed);
+                let missed = state.missed_at_close.unwrap_or_else(|| {
+                    self.queue
+                        .missed
+                        .load(Ordering::Relaxed)
+                        .saturating_sub(self.queue.missed_at_start)
+                });
+                let closed = self.queue.closed.load(Ordering::Acquire);
+                if closed || !state.events.is_empty() || state.reported != (dropped, missed) {
+                    state.reported = (dropped, missed);
+                    let count = state.events.len().min(BATCH_SIZE);
+                    let events = state.events.drain(..count).collect();
+                    return HttpObservationBatch {
+                        events,
+                        dropped_events: dropped,
+                        missed_attempt_starts: missed,
+                        closed,
+                    };
+                }
+            }
+            ready.await;
+        }
+    }
+
+    /// Immediately stop ingress, erase queued metadata and wake readers. Idempotent.
+    pub fn close(&self) {
+        self.queue.close();
+    }
+}
+
+impl Drop for HttpObservationSubscription {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+#[derive(Default)]
+struct QueueState {
+    events: VecDeque<HttpObservationEvent>,
+    reported: (u64, u64),
+    missed_at_close: Option<u64>,
+}
+
+struct Queue {
+    state: Mutex<QueueState>,
+    closed: AtomicBool,
+    ready: Notify,
+    capacity: usize,
+    dropped: AtomicU64,
+    missed: Arc<AtomicU64>,
+    missed_at_start: u64,
+}
+
+impl Queue {
+    fn emit(&self, event: HttpObservationEvent) -> bool {
+        if self.closed.load(Ordering::Acquire) {
+            return false;
+        }
+        let Ok(mut state) = self.state.try_lock() else {
+            if !self.closed.load(Ordering::Acquire) {
+                increment(&self.dropped);
+            }
+            self.ready.notify_one();
+            return false;
+        };
+        if self.closed.load(Ordering::Acquire) {
+            return false;
+        }
+        if state.events.len() == self.capacity {
+            increment(&self.dropped);
+            self.ready.notify_one();
+            return false;
+        }
+        state.events.push_back(event);
+        drop(state);
+        self.ready.notify_one();
+        true
+    }
+
+    fn close(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if self.closed.load(Ordering::Acquire) {
+            return;
+        }
+        state.missed_at_close =
+            Some(self.missed.load(Ordering::Relaxed).saturating_sub(self.missed_at_start));
+        self.closed.store(true, Ordering::Release);
+        state.events.clear();
+        drop(state);
+        self.ready.notify_waiters();
+    }
+}
+
+/// Client-owned registry. Only a weak reference to the collector is retained.
+#[derive(Default)]
+pub(crate) struct HttpObservationRegistry {
+    current: Mutex<Weak<Queue>>,
+    active: AtomicBool,
+    next_id: AtomicU64,
+    missed: Arc<AtomicU64>,
+}
+
+impl fmt::Debug for HttpObservationRegistry {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("HttpObservationRegistry([redacted])")
+    }
+}
+
+impl Drop for HttpObservationRegistry {
+    fn drop(&mut self) {
+        if let Some(queue) = self.current.get_mut().unwrap_or_else(|e| e.into_inner()).upgrade() {
+            queue.close();
+        }
+    }
+}
+
+impl HttpObservationRegistry {
+    pub(crate) fn subscribe(&self) -> HttpObservationSubscription {
+        let mut current = self.current.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(old) = current.upgrade() {
+            old.close();
+        }
+        let queue = Arc::new(Queue {
+            state: Mutex::default(),
+            closed: AtomicBool::new(false),
+            ready: Notify::new(),
+            capacity: CAPACITY,
+            dropped: AtomicU64::new(0),
+            missed: self.missed.clone(),
+            missed_at_start: self.missed.load(Ordering::Relaxed),
+        });
+        *current = Arc::downgrade(&queue);
+        self.active.store(true, Ordering::Release);
+        HttpObservationSubscription { queue }
+    }
+
+    pub(crate) fn begin(
+        &self,
+        request: &reqwest::Request,
+        attempt: u64,
+    ) -> Option<ObservedAttempt> {
+        if !self.active.load(Ordering::Acquire) {
+            return None;
+        }
+        let current = match self.current.try_lock() {
+            Ok(current) => current.upgrade(),
+            Err(_) => {
+                increment(&self.missed);
+                return None;
+            }
+        }?;
+        if current.closed.load(Ordering::Acquire) {
+            return None;
+        }
+        let id = self
+            .next_id
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+            .ok()?;
+        let started = Instant::now();
+        let event = HttpObservationEvent::Started {
+            id,
+            attempt,
+            started_at_epoch_millis: MilliSecondsSinceUnixEpoch::now().get().into(),
+            request: request_metadata(request),
+        };
+        // A missing start cannot produce a misleading response-only row.
+        if !current.emit(event) {
+            return None;
+        }
+        Some(ObservedAttempt { queue: current, id, started, finished: false })
+    }
+}
+
+pub(crate) struct ObservedAttempt {
+    queue: Arc<Queue>,
+    id: u64,
+    started: Instant,
+    finished: bool,
+}
+
+impl ObservedAttempt {
+    fn elapsed(&self) -> u64 {
+        Instant::now()
+            .saturating_duration_since(self.started)
+            .as_millis()
+            .try_into()
+            .unwrap_or(u64::MAX)
+    }
+
+    pub(crate) fn response(&self, response: &reqwest::Response) {
+        let mut truncated = false;
+        let header_names = header_names(response.headers(), &mut truncated);
+        self.queue.emit(HttpObservationEvent::Response {
+            id: self.id,
+            status: response.status().as_u16(),
+            elapsed_millis: self.elapsed(),
+            header_names,
+            truncated,
+        });
+    }
+
+    pub(crate) fn finish(
+        &mut self,
+        response_bytes: Option<u64>,
+        failure: Option<HttpObservedFailure>,
+    ) {
+        self.finished = true;
+        self.queue.emit(HttpObservationEvent::Finished {
+            id: self.id,
+            elapsed_millis: self.elapsed(),
+            response_bytes,
+            failure,
+        });
+    }
+
+    pub(crate) fn fail(&mut self, error: &reqwest::Error) {
+        let category = if error.is_timeout() {
+            HttpObservedFailure::Timeout
+        } else {
+            #[cfg(not(target_family = "wasm"))]
+            if error.is_connect() {
+                self.finish(None, Some(HttpObservedFailure::Connection));
+                return;
+            }
+            HttpObservedFailure::Other
+        };
+        self.finish(None, Some(category));
+    }
+}
+
+impl Drop for ObservedAttempt {
+    fn drop(&mut self) {
+        if !self.finished {
+            self.finish(None, Some(HttpObservedFailure::Cancelled));
+        }
+    }
+}
+
+fn increment(value: &AtomicU64) {
+    let _ = value.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |v| Some(v.saturating_add(1)));
+}
+
+fn bounded(value: &str, limit: usize, truncated: &mut bool) -> String {
+    let mut end = value.len().min(limit);
+    while !value.is_char_boundary(end) {
+        end -= 1;
+    }
+    *truncated |= end < value.len();
+    value[..end].to_owned()
+}
+
+fn header_names(headers: &http::HeaderMap, truncated: &mut bool) -> Vec<String> {
+    let mut result = Vec::new();
+    for name in headers.keys().take(33) {
+        if result.len() == 32 {
+            *truncated = true;
+            break;
+        }
+        result.push(bounded(name.as_str(), 64, truncated));
+    }
+    result
+}
+
+fn request_metadata(request: &reqwest::Request) -> HttpObservedRequest {
+    let url = request.url();
+    let mut truncated = false;
+    let mut query_names = Vec::new();
+    if let Some(query) = url.query() {
+        // Limit scan work as well as retained names, including a huge value without '&'.
+        let mut end = query.len().min(8192);
+        while !query.is_char_boundary(end) {
+            end -= 1;
+        }
+        truncated |= end < query.len();
+        let query = &query[..end];
+        for entry in query.split('&').take(33) {
+            if query_names.len() == 32 {
+                truncated = true;
+                break;
+            }
+            let name = entry.split_once('=').map_or(entry, |(name, _)| name);
+            query_names.push(bounded(name, 64, &mut truncated));
+        }
+    }
+    HttpObservedRequest {
+        method: bounded(request.method().as_str(), 16, &mut truncated),
+        scheme: bounded(url.scheme(), 16, &mut truncated),
+        host: bounded(url.host_str().unwrap_or_default(), 253, &mut truncated),
+        port: url.port_or_known_default(),
+        path: bounded(url.path(), 1024, &mut truncated),
+        query_names,
+        header_names: header_names(request.headers(), &mut truncated),
+        truncated,
+    }
+}
