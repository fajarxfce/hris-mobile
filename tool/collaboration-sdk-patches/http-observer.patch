new file mode 100644
index 0000000..3f3f1d3
--- /dev/null
+++ b/bindings/matrix-sdk-ffi/src/http_observer.rs
@@ -0,0 +1,148 @@
+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::sync::Arc;
+
+use matrix_sdk::http_observer as sdk;
+
+use crate::client::Client;
+
+/// Bounded native metadata. No body, query value, URL credential or header value.
+#[derive(uniffi::Record)]
+pub struct HttpObservedRequest {
+    pub method: String,
+    pub scheme: String,
+    pub host: String,
+    pub port: Option<u16>,
+    pub path: String,
+    pub query_names: Vec<String>,
+    pub header_names: Vec<String>,
+    pub truncated: bool,
+}
+
+impl std::fmt::Debug for HttpObservedRequest {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("HttpObservedRequest([redacted])")
+    }
+}
+
+#[derive(Debug, uniffi::Enum)]
+pub enum HttpObservedFailure {
+    Timeout,
+    Connection,
+    Cancelled,
+    Other,
+}
+
+#[derive(Debug, uniffi::Enum)]
+pub enum HttpObservationEvent {
+    Started {
+        id: u64,
+        attempt: u64,
+        started_at_epoch_millis: u64,
+        request: HttpObservedRequest,
+    },
+    Response {
+        id: u64,
+        status: u16,
+        elapsed_millis: u64,
+        header_names: Vec<String>,
+        truncated: bool,
+    },
+    Finished {
+        id: u64,
+        elapsed_millis: u64,
+        response_bytes: Option<u64>,
+        failure: Option<HttpObservedFailure>,
+    },
+}
+
+#[derive(Debug, uniffi::Record)]
+pub struct HttpObservationBatch {
+    pub events: Vec<HttpObservationEvent>,
+    pub dropped_events: u64,
+    pub missed_attempt_starts: u64,
+    pub closed: bool,
+}
+
+/// A pull-based owner. No foreign callback executes on the HTTP request path.
+#[derive(uniffi::Object)]
+pub struct HttpObservationSubscription {
+    inner: sdk::HttpObservationSubscription,
+}
+
+#[matrix_sdk_ffi_macros::export]
+impl HttpObservationSubscription {
+    /// At most 32 observations; close wakes a pending read with an empty closed batch.
+    pub async fn next_batch(&self) -> HttpObservationBatch {
+        let batch = self.inner.next_batch().await;
+        HttpObservationBatch {
+            events: batch.events.into_iter().map(Into::into).collect(),
+            dropped_events: batch.dropped_events,
+            missed_attempt_starts: batch.missed_attempt_starts,
+            closed: batch.closed,
+        }
+    }
+
+    /// Erase buffered metadata and reject late observations. Safe to call repeatedly.
+    /// Named separately from Kotlin's generated AutoCloseable::close (handle disposal).
+    pub fn stop(&self) {
+        self.inner.close();
+    }
+}
+
+#[matrix_sdk_ffi_macros::export]
+impl Client {
+    /// Observe SDK Matrix HTTP attempts. Does not include the separate OAuth client,
+    /// raw reqwest calls, or redirects performed internally by the HTTP engine.
+    pub fn observe_http_requests(&self) -> Arc<HttpObservationSubscription> {
+        Arc::new(HttpObservationSubscription { inner: self.inner.observe_http_requests() })
+    }
+}
+
+impl From<sdk::HttpObservationEvent> for HttpObservationEvent {
+    fn from(value: sdk::HttpObservationEvent) -> Self {
+        match value {
+            sdk::HttpObservationEvent::Started {
+                id,
+                attempt,
+                started_at_epoch_millis,
+                request,
+            } => Self::Started {
+                id,
+                attempt,
+                started_at_epoch_millis,
+                request: HttpObservedRequest {
+                    method: request.method,
+                    scheme: request.scheme,
+                    host: request.host,
+                    port: request.port,
+                    path: request.path,
+                    query_names: request.query_names,
+                    header_names: request.header_names,
+                    truncated: request.truncated,
+                },
+            },
+            sdk::HttpObservationEvent::Response {
+                id,
+                status,
+                elapsed_millis,
+                header_names,
+                truncated,
+            } => Self::Response { id, status, elapsed_millis, header_names, truncated },
+            sdk::HttpObservationEvent::Finished { id, elapsed_millis, response_bytes, failure } => {
+                Self::Finished {
+                    id,
+                    elapsed_millis,
+                    response_bytes,
+                    failure: failure.map(|failure| match failure {
+                        sdk::HttpObservedFailure::Timeout => HttpObservedFailure::Timeout,
+                        sdk::HttpObservedFailure::Connection => HttpObservedFailure::Connection,
+                        sdk::HttpObservedFailure::Cancelled => HttpObservedFailure::Cancelled,
+                        sdk::HttpObservedFailure::Other => HttpObservedFailure::Other,
+                    }),
+                }
+            }
+        }
+    }
+}
