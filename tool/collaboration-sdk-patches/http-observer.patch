@@ -0,0 +1,248 @@
+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::time::Duration;
+
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::TcpListener,
+    sync::oneshot,
+};
+use wiremock::{
+    Mock, MockServer, ResponseTemplate,
+    matchers::{method, path},
+};
+
+use super::*;
+use crate::http_observer::{HttpObservationEvent, HttpObservedFailure};
+
+fn client() -> HttpClient {
+    HttpClient::new(reqwest::Client::new(), RequestConfig::default())
+}
+
+#[tokio::test]
+async fn http_status_and_original_bytes_survive_observation() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/request"))
+        .respond_with(
+            ResponseTemplate::new(401)
+                .insert_header("set-cookie", "private-cookie")
+                .set_body_string("original-response"),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let client = client();
+    let subscription = client.observations.subscribe();
+    let request = client
+        .inner
+        .post(format!("{}/request?access_token=private-query", server.uri()))
+        .header("authorization", "Bearer private-token")
+        .body("original-request")
+        .build()
+        .unwrap();
+    let response = client.execute_observed(request, 1).await.unwrap();
+    assert_eq!(response.status().as_u16(), 401);
+    assert_eq!(response.body().as_ref(), b"original-response");
+    let received = server.received_requests().await.unwrap();
+    assert_eq!(received.len(), 1);
+    assert_eq!(received[0].body.as_slice(), b"original-request");
+    assert_eq!(received[0].headers.get("authorization").unwrap(), "Bearer private-token");
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.events.len(), 3);
+    assert!(matches!(batch.events[1], HttpObservationEvent::Response { status: 401, .. }));
+    assert!(matches!(
+        batch.events[2],
+        HttpObservationEvent::Finished { response_bytes: Some(17), failure: None, .. }
+    ));
+    assert!(!format!("{batch:?}").contains("private-"));
+}
+
+#[tokio::test]
+async fn sdk_retry_has_distinct_attempts_and_actual_server_count() {
+    use ruma::api::client::discovery::get_supported_versions;
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(429).insert_header("retry-after", "0").set_body_json(
+            serde_json::json!({"errcode":"M_LIMIT_EXCEEDED","error":"retry","retry_after_ms":1}),
+        ))
+        .up_to_n_times(1)
+        .with_priority(1)
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .respond_with(
+            ResponseTemplate::new(200).set_body_json(serde_json::json!({"versions":["v1.11"]})),
+        )
+        .with_priority(2)
+        .expect(1)
+        .mount(&server)
+        .await;
+    let client = client();
+    let subscription = client.observations.subscribe();
+    let request = http::Request::builder().uri(server.uri()).body(Bytes::new()).unwrap();
+    client
+        .send_request::<get_supported_versions::Request>(
+            request,
+            RequestConfig::default().retry_limit(2).max_retry_time(Duration::from_millis(5)),
+            SharedObservable::default(),
+        )
+        .await
+        .unwrap();
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.events.len(), 6);
+    let starts: Vec<_> = batch
+        .events
+        .iter()
+        .filter_map(|e| match e {
+            HttpObservationEvent::Started { id, attempt, .. } => Some((*id, *attempt)),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(starts.len(), 2);
+    assert_eq!(starts[0].1, 1);
+    assert_eq!(starts[1].1, 2);
+    assert_ne!(starts[0].0, starts[1].0);
+    let statuses: Vec<_> = batch
+        .events
+        .iter()
+        .filter_map(|e| match e {
+            HttpObservationEvent::Response { status, .. } => Some(*status),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(statuses, vec![429, 200]);
+    assert_eq!(server.received_requests().await.unwrap().len(), 2);
+}
+
+#[tokio::test]
+async fn cancellation_before_headers_is_not_a_response() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(200).set_delay(Duration::from_millis(250)))
+        .mount(&server)
+        .await;
+    let client = client();
+    let subscription = client.observations.subscribe();
+    let request = client.inner.get(server.uri()).build().unwrap();
+    let result =
+        tokio::time::timeout(Duration::from_millis(50), client.execute_observed(request, 1)).await;
+    assert!(result.is_err());
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.events.len(), 2);
+    assert!(matches!(
+        batch.events[1],
+        HttpObservationEvent::Finished {
+            failure: Some(HttpObservedFailure::Cancelled),
+            response_bytes: None,
+            ..
+        }
+    ));
+}
+
+// The server sends real headers and an incomplete body, then awaits explicit release.
+async fn partial_body_server() -> (String, oneshot::Sender<()>, tokio::task::JoinHandle<()>) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (release, closed) = oneshot::channel();
+    let task = tokio::spawn(async move {
+        let (mut socket, _) = listener.accept().await.unwrap();
+        let mut request = [0u8; 2048];
+        assert!(socket.read(&mut request).await.unwrap() > 0);
+        socket
+            .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 1024\r\nConnection: close\r\n\r\nabc")
+            .await
+            .unwrap();
+        socket.flush().await.unwrap();
+        let _ = closed.await;
+    });
+    (format!("http://{address}/body"), release, task)
+}
+
+#[tokio::test]
+async fn cancellation_during_body_retains_real_response_status() {
+    let (url, release, server) = partial_body_server().await;
+    let client = client();
+    let subscription = client.observations.subscribe();
+    let request = client.inner.get(url).build().unwrap();
+    let request_client = client.clone();
+    let task = tokio::spawn(async move { request_client.execute_observed(request, 1).await });
+    let mut events = Vec::new();
+    tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            events.extend(subscription.next_batch().await.events);
+            if events
+                .iter()
+                .any(|e| matches!(e, HttpObservationEvent::Response { status: 200, .. }))
+            {
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    events.extend(subscription.next_batch().await.events);
+    assert_eq!(events.len(), 3);
+    assert!(matches!(
+        events[2],
+        HttpObservationEvent::Finished {
+            failure: Some(HttpObservedFailure::Cancelled),
+            response_bytes: None,
+            ..
+        }
+    ));
+    drop(release);
+    server.await.unwrap();
+}
+
+#[tokio::test]
+async fn broken_body_preserves_headers_and_original_error() {
+    let (url, release, server) = partial_body_server().await;
+    let client = client();
+    let subscription = client.observations.subscribe();
+    let request = client.inner.get(url).build().unwrap();
+    drop(release);
+    assert!(client.execute_observed(request, 1).await.unwrap_err().is_decode());
+    server.await.unwrap();
+    let batch = subscription.next_batch().await;
+    assert_eq!(batch.events.len(), 3);
+    assert!(matches!(batch.events[1], HttpObservationEvent::Response { status: 200, .. }));
+    assert!(matches!(
+        batch.events[2],
+        HttpObservationEvent::Finished {
+            response_bytes: None,
+            failure: Some(HttpObservedFailure::Other),
+            ..
+        }
+    ));
+}
+
+#[tokio::test]
+async fn saturated_unconsumed_capture_cannot_stall_http() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(200).set_body_string("ok"))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let client = client();
+    let subscription = client.observations.subscribe();
+    let request = client.inner.get(server.uri()).build().unwrap();
+    for _ in 0..300 {
+        drop(client.observations.begin(&request, 1));
+    }
+    let response =
+        tokio::time::timeout(Duration::from_secs(2), client.execute_observed(request, 1))
+            .await
+            .unwrap()
+            .unwrap();
+    assert_eq!(response.body().as_ref(), b"ok");
+    let batch = subscription.next_batch().await;
+    assert!(batch.dropped_events > 0);
+    assert_eq!(batch.events.len(), 32);
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+}
