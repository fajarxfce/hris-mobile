+use super::*;
+use matrix_sdk::test_utils::mocks::MatrixMockServer;
+use matrix_sdk_test::JoinedRoomBuilder;
+use ruma::{event_id, room_id, serde::Raw};
+use serde_json::json;
+use tokio::time::{sleep, timeout};
+
+fn raw(text: &str) -> Raw<AnySyncTimelineEvent> {
+    Raw::from_json(RawJsonValue::from_string(text.to_owned()).unwrap())
+}
+
+fn replacement() -> Raw<AnySyncTimelineEvent> {
+    raw(&json!({
+        "event_id": "$raw", "sender": "@alice:example.org",
+        "origin_server_ts": 1_700_000_000_000_u64, "type": "m.room.message",
+        "content": {
+            "msgtype": "m.text", "body": "* Changed",
+            "m.relates_to": {"rel_type": "m.replace", "event_id": "$original"},
+            "org.hris.edit_id": "00000000-0000-0000-0000-000000000001",
+            "m.new_content": {
+                "msgtype": "m.text", "body": "Changed",
+                "org.hris.message_id": "00000000-0000-0000-0000-000000000002",
+                "m.relates_to": {"m.in_reply_to": {"event_id": "$quote"}},
+                "org.hris.forwarded": true
+            }
+        }
+    }).to_string())
+}
+
+#[test]
+fn raw_event_retains_exact_unknown_content_and_escaped_identity() {
+    for text in [
+        r#"{ "event_id": "$raw", "content": {"unknown": [1,2,3]} }"#,
+        r#"{ "event_id": "\u0024raw", "content": {"unknown": "\u00e9"} }"#,
+    ] {
+        assert_eq!(checked_raw_event_json(&raw(text), event_id!("$raw")).unwrap(), text);
+    }
+    let edit = replacement();
+    assert_eq!(checked_raw_event_json(&edit, event_id!("$raw")).unwrap(), edit.json().get());
+}
+
+#[test]
+fn raw_event_rejects_missing_wrong_or_nonstring_identity() {
+    for text in [r#"{}"#, r#"{"event_id":"$other"}"#, r#"{"event_id":7}"#] {
+        assert!(checked_raw_event_json(&raw(text), event_id!("$raw")).is_err());
+    }
+}
+
+#[test]
+fn raw_event_limit_counts_utf8_bytes_before_copying() {
+    let prefix = r#"{"event_id":"$raw","content":""#;
+    let suffix = "\"}";
+    let available = 96_000 - prefix.len() - suffix.len();
+    let text = format!("{prefix}{}{suffix}", "é".repeat(available / 2) + "a".repeat(available % 2).as_str());
+    assert_eq!(text.len(), 96_000);
+    assert_eq!(checked_raw_event_json(&raw(&text), event_id!("$raw")).unwrap(), text);
+    let too_large = text.replacen("content\":\"", "content\":\"a", 1);
+    assert!(checked_raw_event_json(&raw(&too_large), event_id!("$raw")).is_err());
+}
+
+#[tokio::test]
+async fn raw_event_network_fetch_preserves_extensions_without_writing_event_cache() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    let id = room_id!("!raw:example.org");
+    let sdk_room = server.sync_joined_room(&client, id).await;
+    let (cache, _handles) = client.event_cache().unwrap().room(id).await.unwrap();
+    let source = replacement();
+    server.mock_room_event().room(id).match_event_id()
+        .ok(SdkTimelineEvent::from_plaintext(source.clone())).mock_once().mount().await;
+    let room = Room::new(sdk_room, None);
+    let loaded = room.load_or_fetch_raw_event("$raw".to_owned()).await.unwrap();
+    assert_eq!(loaded.json, source.json().get());
+    assert_eq!(loaded.encryption, RawEventEncryption::NotDecrypted);
+    assert!(cache.find_event(event_id!("$raw")).await.unwrap().is_none());
+}
+
+#[tokio::test]
+async fn raw_event_reads_the_existing_cache_without_a_network_request() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    let id = room_id!("!raw:example.org");
+    let sdk_room = server.sync_joined_room(&client, id).await;
+    let (cache, _handles) = client.event_cache().unwrap().room(id).await.unwrap();
+    let (_, mut changes) = cache.subscribe().await.unwrap();
+    let source = replacement();
+    server.mock_sync().ok_and_run(&client, |sync| {
+        sync.add_joined_room(JoinedRoomBuilder::new(id).add_timeline_event(source.clone()));
+    }).await;
+    timeout(Duration::from_secs(5), changes.recv()).await.unwrap().unwrap();
+    let room = Room::new(sdk_room, None);
+    let loaded = room.load_or_fetch_raw_event("$raw".to_owned()).await.unwrap();
+    assert_eq!(loaded.json, source.json().get());
+    assert_eq!(loaded.encryption, RawEventEncryption::NotDecrypted);
+    let requests = server.server().received_requests().await.unwrap();
+    assert!(!requests.iter().any(|request| request.url.path().contains("/event/")));
+}
+
+#[tokio::test]
+async fn raw_event_cancellation_drops_the_pending_request_and_allows_a_later_read() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    let id = room_id!("!raw:example.org");
+    let room = Arc::new(Room::new(server.sync_joined_room(&client, id).await, None));
+    let source = replacement();
+    server.mock_room_event().room(id).match_event_id().with_delay(Duration::from_secs(20))
+        .ok(SdkTimelineEvent::from_plaintext(source.clone())).mock_once().mount().await;
+    let read = room.clone();
+    let pending = tokio::spawn(async move { read.load_or_fetch_raw_event("$raw".to_owned()).await });
+    timeout(Duration::from_secs(5), async {
+        loop {
+            let requests = server.server().received_requests().await.unwrap();
+            if requests.iter().any(|request| request.url.path().contains("/event/")) { break; }
+            sleep(Duration::from_millis(5)).await;
+        }
+    }).await.unwrap();
+    pending.abort();
+    assert!(matches!(pending.await, Err(error) if error.is_cancelled()));
+    server.mock_room_event().room(id).match_event_id()
+        .ok(SdkTimelineEvent::from_plaintext(source.clone())).mock_once().mount().await;
+    let later = timeout(Duration::from_secs(5), room.load_or_fetch_raw_event("$raw".to_owned()))
+        .await.unwrap().unwrap();
+    assert_eq!(later.json, source.json().get());
+    assert_eq!(later.encryption, RawEventEncryption::NotDecrypted);
+}
