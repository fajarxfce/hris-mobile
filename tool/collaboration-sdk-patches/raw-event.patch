+/// Exact event JSON together with the SDK's decryption result.
+/// Intentionally does not implement Debug: event content can be private.
+#[derive(uniffi::Record)]
+pub struct RawTimelineEvent {
+    pub json: String,
+    pub encryption: RawEventEncryption,
+}
+
+/// Cryptographic provenance, separate from sender/device verification.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, uniffi::Enum)]
+pub enum RawEventEncryption {
+    /// No successful decryption; the SDK fallback can also contain malformed ciphertext.
+    NotDecrypted,
+    Decrypted,
+    UnableToDecrypt,
+}
+
+fn checked_raw_event(
+    kind: &TimelineEventKind,
+    event_id: &EventId,
+) -> Result<RawTimelineEvent, ClientError> {
+    let json = checked_raw_event_json(kind.raw(), event_id)?;
+    let encryption = match kind {
+        TimelineEventKind::PlainText { .. } => RawEventEncryption::NotDecrypted,
+        TimelineEventKind::Decrypted(_) => RawEventEncryption::Decrypted,
+        TimelineEventKind::UnableToDecrypt { .. } => RawEventEncryption::UnableToDecrypt,
+    };
+    Ok(RawTimelineEvent { json, encryption })
+}
+
+// Bound before allocating or deserializing fields. Preserve exact source bytes.
+fn checked_raw_event_json(
+    raw: &ruma::serde::Raw<AnySyncTimelineEvent>,
+    event_id: &EventId,
+) -> Result<String, ClientError> {
+    let json = raw.json().get();
+    if json.len() > 96_000 {
+        return Err(ClientError::from_str("Raw event exceeds the byte limit", None));
+    }
+    let identity: Option<String> = raw.get_field("event_id")?;
+    if identity.as_deref() != Some(event_id.as_str()) {
+        return Err(ClientError::from_str("Raw event identity mismatch", None));
+    }
+    Ok(json.to_owned())
+}
