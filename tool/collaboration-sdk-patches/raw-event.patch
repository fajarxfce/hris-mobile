+#[tokio::test]
+async fn raw_event_encrypted_edit_retains_extensions_missing_keys_and_cold_cache() {
+    timeout(Duration::from_secs(40), async {
+        let server = MatrixMockServer::new().await;
+        server.mock_crypto_endpoints_preset().await;
+        let dir = tempfile::tempdir().unwrap();
+        let user = ruma::user_id!("@alice:example.org");
+        let device = ruma::device_id!("RAWALICE");
+        let id = room_id!("!raw:example.org");
+        let alice = server.client_builder_for_crypto_end_to_end(user, device)
+            .on_builder(|builder| builder.sqlite_store(dir.path(), None)).build().await;
+        let factory = matrix_sdk_test::event_factory::EventFactory::new().room(id).sender(user);
+        server.mock_sync().ok_and_run(&alice, |sync| {
+            sync.add_joined_room(JoinedRoomBuilder::new(id)
+                .add_state_event(factory.create(user, ruma::RoomVersionId::V1))
+                .add_state_event(factory.room_encryption())
+                .add_state_event(factory.member(user)));
+        }).await;
+        let sdk_room = alice.get_room(id).unwrap();
+        let content: serde_json::Value = replacement().get_field("content").unwrap().unwrap();
+        let (received, send) = server.mock_room_send().ok_with_capture(event_id!("$raw"), user);
+        send.mock_once().mount().await;
+        server.mock_get_members().ok(vec![factory.member(user).into_raw()]).mock_once().mount().await;
+        sdk_room.send_raw("m.room.message", content.clone()).await.unwrap();
+        let ciphertext = received.await.unwrap();
+        assert_eq!(ciphertext.get_field::<String>("type").unwrap().as_deref(), Some("m.room.encrypted"));
+        assert!(!ciphertext.json().get().contains("org.hris.edit_id"));
+        server.mock_room_event().room(id).match_event_id().expect_access_token("TOKEN_0")
+            .ok(SdkTimelineEvent::from_plaintext(ciphertext.clone())).mock_once().mount().await;
+        let room = Room::new(sdk_room, None);
+        let loaded = room.load_or_fetch_raw_event("$raw".to_owned()).await.unwrap();
+        assert_eq!(loaded.encryption, RawEventEncryption::Decrypted);
+        assert_eq!(raw(&loaded.json).get_field::<serde_json::Value>("content").unwrap().unwrap(), content);
+
+        // An unrelated crypto store must retain ciphertext, not fabricate a plaintext result.
+        let bob = server.client_builder_for_crypto_end_to_end(
+            ruma::user_id!("@bob:example.org"), ruma::device_id!("RAWBOB")).build().await;
+        let bob_room = Room::new(server.sync_joined_room(&bob, id).await, None);
+        server.mock_room_event().room(id).match_event_id().expect_access_token("TOKEN_1")
+            .ok(SdkTimelineEvent::from_plaintext(ciphertext.clone())).mock_once().mount().await;
+        let unavailable = bob_room.load_or_fetch_raw_event("$raw".to_owned()).await.unwrap();
+        assert_eq!(unavailable.encryption, RawEventEncryption::UnableToDecrypt);
+        assert_eq!(raw(&unavailable.json).get_field::<String>("type").unwrap().as_deref(), Some("m.room.encrypted"));
+        drop(bob_room);
+        drop(bob);
+
+        // Only sync owns cache persistence. A fetched point read must not insert it.
+        let (cache, handles) = alice.event_cache().unwrap().room(id).await.unwrap();
+        assert!(cache.find_event(event_id!("$raw")).await.unwrap().is_none());
+        let (_, mut changes) = cache.subscribe().await.unwrap();
+        server.mock_sync().ok_and_run(&alice, |sync| {
+            sync.add_joined_room(JoinedRoomBuilder::new(id).add_timeline_event(ciphertext));
+        }).await;
+        timeout(Duration::from_secs(5), changes.recv()).await.unwrap().unwrap();
+        assert!(cache.find_event(event_id!("$raw")).await.unwrap().is_some());
+        let before = server.server().received_requests().await.unwrap().into_iter()
+            .filter(|request| request.url.path().contains("/event/")).count();
+        drop(changes);
+        drop(cache);
+        drop(handles);
+        drop(room);
+        drop(alice);
+
+        let restored = server.client_builder_for_crypto_end_to_end(user, device)
+            .on_builder(|builder| builder.sqlite_store(dir.path(), None)).build().await;
+        let restored_room = Room::new(restored.get_room(id).unwrap(), None);
+        let cold = restored_room.load_or_fetch_raw_event("$raw".to_owned()).await.unwrap();
+        assert_eq!(cold.encryption, RawEventEncryption::Decrypted);
+        assert_eq!(raw(&cold.json).get_field::<serde_json::Value>("content").unwrap().unwrap(), content);
+        let after = server.server().received_requests().await.unwrap().into_iter()
+            .filter(|request| request.url.path().contains("/event/")).count();
+        assert_eq!(before, after);
+    }).await.unwrap();
+}
