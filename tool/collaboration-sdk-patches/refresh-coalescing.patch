+        tokio::time::timeout(Duration::from_secs(1), received_old_request.notified())
+            .await
+            .unwrap();
+        tokio::time::timeout(Duration::from_secs(1), client.refresh_access_token())
+            .await
+            .unwrap()
+            .unwrap();
+    });
+    response.expect("The delayed old-token error must use the current OAuth access token");
+    assert_eq!(changes.try_recv(), Ok(SessionChange::TokensRefreshed));
