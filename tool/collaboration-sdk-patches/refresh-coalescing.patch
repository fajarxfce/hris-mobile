 #[async_test]
+async fn test_late_unknown_token_retries_the_current_access_token_without_rotating_again() {
+    let (builder, server) = test_client_builder_with_server().await;
+    let client = builder
+        .request_config(RequestConfig::new().disable_retry())
+        .server_versions([MatrixVersion::V1_3])
+        .handle_refresh_tokens()
+        .build()
+        .await
+        .unwrap();
+    client.matrix_auth().restore_session(session(), RoomLoadSettings::default()).await.unwrap();
+    let mut changes = client.subscribe_to_session_changes();
+    let received_old_request = Arc::new(tokio::sync::Notify::new());
+
+    Mock::given(method("GET"))
+        .and(path("/_matrix/client/v3/account/whoami"))
+        .and(header(http::header::AUTHORIZATION, "Bearer 1234"))
+        .respond_with({
+            let received = received_old_request.clone();
+            move |_: &wiremock::Request| {
+                received.notify_one();
+                ResponseTemplate::new(401)
+                    .set_body_json(&*test_json::UNKNOWN_TOKEN_SOFT_LOGOUT)
+                    .set_delay(Duration::from_secs(2))
+            }
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("POST"))
+        .and(path("/_matrix/client/v3/refresh"))
+        .and(body_partial_json(json!({"refresh_token": "abcd"})))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "access_token": "5678", "refresh_token": "efgh", "expires_in_ms": 300000
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("POST"))
+        .and(path("/_matrix/client/v3/refresh"))
+        .and(body_partial_json(json!({"refresh_token": "efgh"})))
+        .respond_with(ResponseTemplate::new(429).set_body_json(json!({
+            "errcode": "M_LIMIT_EXCEEDED", "error": "Rotation too soon", "retry_after_ms": 10000
+        })))
+        .expect(0)
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/_matrix/client/v3/account/whoami"))
+        .and(header(http::header::AUTHORIZATION, "Bearer 5678"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(&*test_json::WHOAMI))
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    // Complete another caller's refresh while this request's old-token rejection is in flight.
+    // The bounded refresh must finish before the delayed response is released.
+    let (response, ()) = tokio::join!(client.whoami(), async {
+        tokio::time::timeout(Duration::from_secs(1), received_old_request.notified())
+            .await
+            .unwrap();
+        tokio::time::timeout(Duration::from_secs(1), client.refresh_access_token())
+            .await
+            .unwrap()
+            .unwrap();
+    });
+    response.expect("A delayed rejection of an old token must retry the already refreshed session");
+    assert_eq!(client.access_token().as_deref(), Some("5678"));
+    assert_eq!(changes.try_recv(), Ok(SessionChange::TokensRefreshed));
+    assert_eq!(changes.try_recv(), Err(TryRecvError::Empty));
+}
