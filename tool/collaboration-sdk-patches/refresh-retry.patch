+#[cfg(test)]
+mod refresh_error_tests {
+    use std::sync::Arc;
+
+    use matrix_sdk::{HttpError, RefreshTokenError, reqwest::StatusCode};
+    use ruma::api::{client::uiaa::UiaaResponse, error::FromHttpResponseError};
+    use serde_json::json;
+
+    use super::{ClientError, ErrorBody, ErrorKind, StandardErrorBody};
+
+    fn refresh_error(status: u16, code: &str) -> ClientError {
+        let body: StandardErrorBody = serde_json::from_value(json!({
+            "errcode": code,
+            "error": "Fictional refresh response",
+            "retry_after_ms": 10000
+        }))
+        .unwrap();
+        let api = ErrorBody::Standard(body).into_error(StatusCode::from_u16(status).unwrap());
+        let error = HttpError::RefreshToken(RefreshTokenError::MatrixAuth(Arc::new(
+            HttpError::Api(Box::new(FromHttpResponseError::Server(UiaaResponse::MatrixError(api)))),
+        )));
+        ClientError::from(matrix_sdk::Error::from(error))
+    }
+
+    #[test]
+    fn wrapped_refresh_rate_limit_keeps_structured_retry_after_for_native_sync() {
+        let ClientError::MatrixApi {
+            kind: ErrorKind::LimitExceeded { retry_after_ms }, code, ..
+        } = refresh_error(429, "M_LIMIT_EXCEEDED")
+        else {
+            panic!("Expected structured refresh rate limit")
+        };
+        assert_eq!(code, "M_LIMIT_EXCEEDED");
+        assert_eq!(retry_after_ms, Some(10000));
+    }
+
+    #[test]
+    fn wrapped_refresh_denials_keep_their_native_authentication_classification() {
+        for (status, expected) in [(401, "M_UNKNOWN_TOKEN"), (403, "M_FORBIDDEN")] {
+            let ClientError::MatrixApi { code, .. } = refresh_error(status, expected) else {
+                panic!("Expected structured refresh denial")
+            };
+            assert_eq!(code, expected);
+        }
+    }
+}
