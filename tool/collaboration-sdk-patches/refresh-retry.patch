+#[async_test]
+async fn test_refresh_token_rate_limit_and_timeout_preserve_the_original_session() {
+    for status in [429, 408] {
+        let (builder, server) = test_client_builder_with_server().await;
+        let client = builder
+            .request_config(RequestConfig::new().disable_retry())
+            .server_versions([MatrixVersion::V1_3])
+            .handle_refresh_tokens()
+            .build()
+            .await
+            .unwrap();
+        let original = session();
+        client
+            .matrix_auth()
+            .restore_session(original.clone(), RoomLoadSettings::default())
+            .await
+            .unwrap();
+        let mut changes = client.subscribe_to_session_changes();
+
+        Mock::given(method("GET"))
+            .and(path("/_matrix/client/v3/account/whoami"))
+            .and(header(http::header::AUTHORIZATION, "Bearer 1234"))
+            .respond_with(
+                ResponseTemplate::new(401).set_body_json(&*test_json::UNKNOWN_TOKEN_SOFT_LOGOUT),
+            )
+            .expect(2)
+            .mount(&server)
+            .await;
+        Mock::given(method("GET"))
+            .and(path("/_matrix/client/v3/account/whoami"))
+            .and(header(http::header::AUTHORIZATION, "Bearer 5678"))
+            .respond_with(ResponseTemplate::new(200).set_body_json(&*test_json::WHOAMI))
+            .expect(1)
+            .mount(&server)
+            .await;
+        let blocked = Mock::given(method("POST"))
+            .and(path("/_matrix/client/v3/refresh"))
+            .and(body_partial_json(json!({"refresh_token":"abcd"})))
+            .respond_with(ResponseTemplate::new(status).set_body_json(json!({
+                "errcode": if status == 429 { "M_LIMIT_EXCEEDED" } else { "M_UNKNOWN" },
+                "error": "Retry later",
+                "retry_after_ms": 10000
+            })))
+            .expect(1)
+            .mount_as_scoped(&server)
+            .await;
+
+        assert_matches!(client.whoami().await, Err(HttpError::RefreshToken(_)));
+        assert_eq!(changes.try_recv(), Err(TryRecvError::Empty));
+        assert_eq!(client.session_tokens().unwrap(), original.tokens);
+        drop(blocked);
+
+        Mock::given(method("POST"))
+            .and(path("/_matrix/client/v3/refresh"))
+            .and(body_partial_json(json!({"refresh_token":"abcd"})))
+            .respond_with(ResponseTemplate::new(200).set_body_json(&*test_json::REFRESH_TOKEN))
+            .expect(1)
+            .mount(&server)
+            .await;
+        client.whoami().await.unwrap();
+        assert_eq!(changes.try_recv(), Ok(SessionChange::TokensRefreshed));
+        assert_eq!(changes.try_recv(), Err(TryRecvError::Empty));
+    }
+}
