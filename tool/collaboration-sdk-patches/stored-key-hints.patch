+// Copyright 2026 Fajar HRIS contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::collections::BTreeSet;
+
+use matrix_sdk_base::crypto::store::types::RoomKeyInfo;
+use matrix_sdk_common::{SendOutsideWasm, SyncOutsideWasm};
+
+/// Stored-key notifications only. This does not grant access to a room or report delivery.
+#[matrix_sdk_ffi_macros::export(callback_interface)]
+pub trait RoomKeyChangesListener: SendOutsideWasm + SyncOutsideWasm {
+    /// Hand off this bounded snapshot promptly; do not perform network/storage work here.
+    fn on_update(&self, changes: RoomKeyChangeBatch);
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, uniffi::Record)]
+pub struct RoomKeyChangeBatch {
+    /// Unique physical room IDs in this notification. No session/key material is exported.
+    pub room_ids: Vec<String>,
+    /// Registration, lag or capacity loss requires reconciling retained missing-key work.
+    /// This is not an instruction to rescan all chat history or to open a second client.
+    pub reconcile_required: bool,
+}
+
+impl RoomKeyChangeBatch {
+    pub(super) fn reconciliation() -> Self {
+        Self { room_ids: Vec::new(), reconcile_required: true }
+    }
+
+    pub(super) fn from_stored_keys(keys: &[RoomKeyInfo]) -> Self {
+        let mut result = Self { room_ids: Vec::new(), reconcile_required: keys.len() > 256 };
+        let mut seen = BTreeSet::new();
+        for key in keys.iter().take(256) {
+            if key.room_id.as_str().len() > 1024 {
+                result.reconcile_required = true;
+                continue;
+            }
+            if !seen.insert(&key.room_id) {
+                continue;
+            }
+            if result.room_ids.len() == 64 {
+                result.reconcile_required = true;
+                break;
+            }
+            result.room_ids.push(key.room_id.to_string());
+        }
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests;
