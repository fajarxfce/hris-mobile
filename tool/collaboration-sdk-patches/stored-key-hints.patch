+    /// Observe already-stored room-key changes on this existing client.
+    ///
+    /// None means the encryption machine is not available. Registration and lag
+    /// emit reconciliation hints because this broadcast has no durable replay.
+    /// The caller owns the TaskHandle, fences callbacks during disposal, and waits
+    /// for is_finished before retiring the native registration. No transport starts.
+    pub async fn subscribe_to_room_key_changes(
+        self: Arc<Self>,
+        listener: Box<dyn RoomKeyChangesListener>,
+    ) -> Option<Arc<TaskHandle>> {
+        let stream = self.inner.room_keys_received_stream().await?;
+        Some(Arc::new(TaskHandle::new(get_runtime_handle().spawn(async move {
+            let _owner = self;
+            let mut stream = Box::pin(stream);
+            listener.on_update(RoomKeyChangeBatch::reconciliation());
+            while let Some(update) = stream.next().await {
+                let changes = match update {
+                    Ok(keys) => RoomKeyChangeBatch::from_stored_keys(&keys),
+                    Err(_) => RoomKeyChangeBatch::reconciliation(),
+                };
+                if changes.reconcile_required || !changes.room_ids.is_empty() {
+                    listener.on_update(changes);
+                }
+            }
+        }))))
+    }
+
     pub fn verification_state(&self) -> VerificationState {
         self.inner.verification_state().get().into()
     }
