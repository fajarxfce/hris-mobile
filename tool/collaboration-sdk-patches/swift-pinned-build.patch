+#[cfg(test)]
+mod private_symbol_crate_tests {
+    use super::crate_of;
+    use std::collections::HashSet;
+
+    #[test]
+    fn rust_196_codegen_units_and_allocator_share_the_crate() {
+        for unit in 0..16 {
+            let name = format!("matrix_sdk_ffi.matrix_sdk_ffi.f1e34f89cd2ae0e2-cgu.{unit:02}.rcgu.o");
+            assert_eq!(crate_of(&name), "matrix_sdk_ffi");
+        }
+        assert_eq!(crate_of("matrix_sdk_ffi.8b7zbn7tftv75m9z7kj4vaoos.rcgu.o"), "matrix_sdk_ffi");
+    }
+
+    #[test]
+    fn legacy_codegen_units_keep_their_existing_group() {
+        assert_eq!(crate_of("rusqlite-0123456789abcdef.rusqlite.cgu.0.rcgu.o"), "rusqlite");
+        assert_eq!(crate_of("rusqlite-0123456789abcdef.allocator.rcgu.o"), "rusqlite");
+    }
+
+    #[test]
+    fn different_rust_crates_never_share_a_group() {
+        let one = "matrix_sdk_ffi.matrix_sdk_ffi.0123456789abcdef-cgu.00.rcgu.o";
+        let two = "matrix_sdk.matrix_sdk.0123456789abcdef-cgu.00.rcgu.o";
+        assert_ne!(crate_of(one), crate_of(two));
+        assert_eq!(crate_of(two), "matrix_sdk");
+    }
+
+    #[test]
+    fn ordinary_c_and_archive_members_keep_their_names() {
+        for name in ["c877a2978823c39d-sqlite3.o", "sqlite3.o", "libmatrix_sdk_ffi_merged.o", "__.SYMDEF SORTED"] {
+            assert_eq!(crate_of(name), name);
+        }
+    }
+
+    #[test]
+    fn malformed_legacy_hashes_are_not_crate_identifiers() {
+        for name in ["ffi-0123456789abcdeg.unit.rcgu.o", "ffi-0123456789abcde.unit.rcgu.o", "ffi-0123456789abcdefunit.rcgu.o"] {
+            assert_eq!(crate_of(name), name);
+        }
+    }
+
+    #[test]
+    fn non_rust_prefixes_and_extensions_remain_independent() {
+        for name in [".hash.rcgu.o", "other-crate.hash.rcgu.o", "sqlite3.hash.o", "unit.rcgu"] {
+            assert_eq!(crate_of(name), name);
+        }
+    }
+
+    #[test]
+    fn a_single_sqlite_caller_selects_every_sibling_codegen_unit() {
+        let caller = "matrix_sdk_ffi.matrix_sdk_ffi.f1e34f89cd2ae0e2-cgu.10.rcgu.o";
+        let crates: HashSet<_> = [crate_of(caller)].into_iter().collect();
+        let mut members: Vec<_> = (0..16).map(|unit| {
+            format!("matrix_sdk_ffi.matrix_sdk_ffi.f1e34f89cd2ae0e2-cgu.{unit:02}.rcgu.o")
+        }).collect();
+        members.push("matrix_sdk_ffi.8b7zbn7tftv75m9z7kj4vaoos.rcgu.o".to_owned());
+        members.push("other_crate.other_crate.f1e34f89cd2ae0e2-cgu.10.rcgu.o".to_owned());
+        let selected: Vec<_> = members.iter().filter(|member| crates.contains(crate_of(member))).collect();
+        assert_eq!(selected.len(), 17);
+        assert!(selected.iter().all(|name| name.starts_with("matrix_sdk_ffi.")));
+    }
+
