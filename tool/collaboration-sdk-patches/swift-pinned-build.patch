 fn crate_of(member: &str) -> &str {
+    // Rust 1.96 names units `crate.crate.hash-cgu.N.rcgu.o` and allocator
+    // shims `crate.hash.rcgu.o`. All units must stay with the crate: merging
+    // only a SQLite caller leaves its hidden references outside `ld -r`.
+    if member.ends_with(".rcgu.o") {
+        if let Some((name, _)) = member.split_once('.') {
+            if !name.is_empty()
+                && name.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'_')
+            {
+                return name;
+            }
+        }
+    }
