+        assert!(!changes.rescan_required);
+    }
+}
+
+#[test]
+fn sync_hints_duplicate_flood_cannot_make_projection_unbounded() {
+    let mut response = joined(&[]);
+    let timeline = &mut response.rooms.joined.values_mut().next().unwrap().timeline;
+    timeline.events = (0..128).map(|_| event("$same")).collect();
+    timeline.events.push(event("$last"));
+    let changes = timeline_changes(&response.rooms);
+    assert_eq!(changes.rooms[0].event_ids, ["$same"]);
+    assert!(changes.rooms[0].limited);
+}
+
+#[test]
+fn sync_hints_global_event_bound_preserves_affected_room_recovery() {
+    let mut response = SyncResponse::default();
+    for i in 0..5 {
+        response.rooms.joined.insert(
+            format!("!room{i}:example.org").try_into().unwrap(),
+            JoinedRoomUpdate {
+                timeline: Timeline {
+                    events: (0..64).map(|j| event(&format!("$r{i}e{j}"))).collect(),
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+        );
+    }
+    let changes = timeline_changes(&response.rooms);
+    assert_eq!(changes.rooms.iter().map(|r| r.event_ids.len()).sum::<usize>(), 256);
+    assert!(changes.rooms[..4].iter().all(|r| !r.limited));
+    assert!(changes.rooms[4].limited);
+    assert!(changes.rooms[4].event_ids.is_empty());
+    assert!(!changes.rescan_required);
+}
+
+#[test]
+fn sync_hints_room_overflow_requires_inventory_recovery() {
+    for count in [64, 65] {
+        let mut response = SyncResponse::default();
+        for i in 0..count {
+            response.rooms.joined.insert(
+                format!("!r{i:03}:example.org").try_into().unwrap(),
+                JoinedRoomUpdate {
+                    timeline: Timeline { events: vec![event("$event")], ..Default::default() },
+                    ..Default::default()
+                },
+            );
+        }
+        let changes = timeline_changes(&response.rooms);
+        assert_eq!(changes.rooms.len(), 64);
+        assert_eq!(changes.rescan_required, count == 65);
+    }
+}
+
+#[test]
+fn sync_hints_conflicting_memberships_cannot_silently_duplicate_room() {
+    let mut response = joined(&["$joined"]);
+    response.rooms.left.insert(
+        room_id!("!a:example.org").to_owned(),
+        LeftRoomUpdate {
+            timeline: Timeline { events: vec![event("$left")], ..Default::default() },
+            ..Default::default()
