+#[tokio::test]
+async fn sync_hints_actual_requests_capture_their_own_position_before_later_sync() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    assert!(client.sync_token().await.is_none());
+    let guard = server.mock_sync().ok(|_| {}).mock_once().mount_as_scoped().await;
+    let first = client.sync_once(SyncSettings::default()).await.unwrap();
+    drop(guard);
+    let first_position = first.next_batch.clone();
+    let guard = server.mock_sync().ok(|_| {}).mock_once().mount_as_scoped().await;
+    let second: SyncResponseV2 = client.sync_once(SyncSettings::default()).await.unwrap().into();
+    drop(guard);
+    assert_eq!(second.previous_batch.as_deref(), Some(first_position.as_str()));
+    assert_ne!(second.next_batch, first_position);
+    assert_eq!(client.sync_token().await.as_deref(), Some(second.next_batch.as_str()));
+    // Convert the retained older response only after the SDK has advanced again.
+    let first: SyncResponseV2 = first.into();
+    assert!(first.previous_batch.is_none());
+    assert_eq!(first.next_batch, first_position);
+    let requests = server.server().received_requests().await.unwrap();
+    let syncs: Vec<_> = requests.iter().filter(|r| r.url.path().ends_with("/sync")).collect();
+    assert_eq!(syncs.len(), 2);
+    assert!(!syncs[0].url.query_pairs().any(|(k, _)| k == "since"));
+    assert!(syncs[1].url.query_pairs().any(|(k, v)| k == "since" && v == first_position));
+}
