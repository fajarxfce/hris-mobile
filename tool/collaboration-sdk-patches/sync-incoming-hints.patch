+use super::*;
+use matrix_sdk::{
+    config::{SyncSettings, SyncToken},
+    sync::{JoinedRoomUpdate, LeftRoomUpdate, SyncResponse},
+    test_utils::mocks::MatrixMockServer,
+};
+use matrix_sdk_common::deserialized_responses::TimelineEvent;
+use matrix_sdk_test::JoinedRoomBuilder;
+use ruma::{events::AnySyncTimelineEvent, room_id, serde::Raw};
+use serde_json::json;
+use tokio::time::{sleep, timeout};
+
+fn event(id: &str) -> TimelineEvent {
+    TimelineEvent::from_plaintext(
+        Raw::new(&json!({
+            "event_id": id, "type": "m.room.message", "sender": "@a:example.org",
+            "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "private body"}
+        }))
+        .unwrap()
+        .cast_unchecked(),
+    )
+}
+
+fn joined(ids: &[&str]) -> SyncResponse {
+    let mut response = SyncResponse {
+        previous_batch: Some("before".into()),
+        next_batch: "after".into(),
+        ..Default::default()
+    };
+    response.rooms.joined.insert(
+        room_id!("!a:example.org").to_owned(),
+        JoinedRoomUpdate {
+            timeline: Timeline {
+                events: ids.iter().map(|id| event(id)).collect(),
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+    );
+    response
+}
+
+#[test]
+fn sync_hints_keep_the_exact_producer_cursor_pair() {
+    let response: SyncResponseV2 = joined(&["$one"]).into();
+    assert_eq!(response.previous_batch.as_deref(), Some("before"));
+    assert_eq!(response.next_batch, "after");
+    assert_eq!(response.timeline_changes.rooms[0].event_ids, ["$one"]);
+    assert_eq!(response.rooms.joined, ["!a:example.org"]);
+}
+
+#[test]
+fn sync_hints_initial_position_remains_absent() {
+    let response: SyncResponseV2 = SyncResponse::default().into();
+    assert!(response.previous_batch.is_none());
+    assert!(response.timeline_changes.rooms.is_empty());
+    assert!(!response.timeline_changes.rescan_required);
+}
+
+#[test]
+fn sync_hints_ignore_ephemeral_receipts_typing_and_account_data() {
+    let mut response = joined(&[]);
+    let room = response.rooms.joined.values_mut().next().unwrap();
+    room.ephemeral = vec![
+        Raw::new(&json!({"type":"m.typing","content":{"user_ids":["@a:example.org"]}}))
+            .unwrap()
+            .cast_unchecked(),
+        Raw::new(&json!({"type":"m.receipt","content":{}})).unwrap().cast_unchecked(),
+    ];
+    room.account_data =
+        vec![Raw::new(&json!({"type":"m.tag","content":{"tags":{}}})).unwrap().cast_unchecked()];
+    let response: SyncResponseV2 = response.into();
+    assert!(response.timeline_changes.rooms.is_empty());
+    assert!(!response.timeline_changes.rescan_required);
+    assert_eq!(response.rooms.joined.len(), 1);
+}
+
+#[test]
+fn sync_hints_retain_unknown_encrypted_redacted_and_state_event_ids_without_bodies() {
+    let mut response = joined(&[]);
+    let room = response.rooms.joined.values_mut().next().unwrap();
+    for (index, kind) in
+        ["m.room.encrypted", "m.room.redaction", "m.sticker", "com.example.future", "m.room.member"]
+            .iter()
+            .enumerate()
+    {
+        let raw = Raw::new(&json!({"event_id":format!("$id{index}"),"type":kind,"content":{"private":"never export"}})).unwrap().cast_unchecked();
+        room.timeline.events.push(TimelineEvent::from_plaintext(raw));
+    }
+    let changes = timeline_changes(&response.rooms);
+    assert_eq!(changes.rooms[0].event_ids, ["$id0", "$id1", "$id2", "$id3", "$id4"]);
+    assert!(!format!("{changes:?}").contains("private"));
+}
+
+#[test]
+fn sync_hints_keep_order_and_deduplicate_only_within_this_room_and_batch() {
+    let first = timeline_changes(&joined(&["$z", "$a", "$z", "$b"]).rooms);
+    assert_eq!(first.rooms[0].event_ids, ["$z", "$a", "$b"]);
+    assert!(!first.rooms[0].limited);
+    let next = timeline_changes(&joined(&["$z"]).rooms);
+    assert_eq!(next.rooms[0].event_ids, ["$z"]);
+}
+
+#[test]
+fn sync_hints_retain_left_room_timeline_and_membership() {
+    let mut response = joined(&["$joined"]);
+    response.rooms.left.insert(
+        room_id!("!b:example.org").to_owned(),
+        LeftRoomUpdate {
+            timeline: Timeline { events: vec![event("$left")], ..Default::default() },
+            ..Default::default()
+        },
+    );
+    let changes = timeline_changes(&response.rooms);
+    assert_eq!(changes.rooms.len(), 2);
+    assert_eq!(changes.rooms[0].membership, SyncTimelineMembershipV2::Joined);
+    assert_eq!(changes.rooms[1].membership, SyncTimelineMembershipV2::Left);
+    assert_eq!(changes.rooms[1].event_ids, ["$left"]);
+}
