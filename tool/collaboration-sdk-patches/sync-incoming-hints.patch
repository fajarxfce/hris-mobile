+#[tokio::test]
+async fn sync_hints_sdk_position_survives_response_loss_and_sqlite_reopen() {
+    let server = MatrixMockServer::new().await;
+    let dir = tempfile::tempdir().unwrap();
+    let client =
+        server.client_builder().on_builder(|b| b.sqlite_store(dir.path(), None)).build().await;
+    let guard = server.mock_sync().ok(|_| {}).mock_once().mount_as_scoped().await;
+    let response = client.sync_once(SyncSettings::default()).await.unwrap();
+    drop(guard);
+    let committed = response.next_batch.clone();
+    drop(response); // No application consumer received or acknowledged this response.
+    drop(client);
+    let before = server.server().received_requests().await.unwrap().len();
+    let restored =
+        server.client_builder().on_builder(|b| b.sqlite_store(dir.path(), None)).build().await;
+    assert_eq!(restored.sync_token().await, Some(committed));
+    assert_eq!(server.server().received_requests().await.unwrap().len(), before);
+}
