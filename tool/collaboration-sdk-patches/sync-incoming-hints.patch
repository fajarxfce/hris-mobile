+    let response: SyncResponseV2 = client.sync_once(SyncSettings::default()).await.unwrap().into();
+    drop(guard);
+    assert_eq!(response.timeline_changes.rooms[0].event_ids, ["$persisted"]);
+    assert!(cache.find_event(ruma::event_id!("$persisted")).await.unwrap().is_some());
