+#[test]
+fn sync_hints_room_event_bound_marks_exactly_the_omitted_suffix() {
+    for count in [64, 65] {
+        let mut response = joined(&[]);
+        response.rooms.joined.values_mut().next().unwrap().timeline.events =
+            (0..count).map(|i| event(&format!("$e{i}"))).collect();
+        let changes = timeline_changes(&response.rooms);
