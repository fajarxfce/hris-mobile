+    response.rooms.joined.values_mut().next().unwrap().timeline.limited = true;
+    let changes = timeline_changes(&response.rooms);
+    assert_eq!(changes.rooms.len(), 1);
+    assert!(changes.rooms[0].limited);
+    assert!(!changes.rescan_required);
+}
