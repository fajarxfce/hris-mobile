+/// Bounded changes in the same successful response as the previous/next cursor pair.
+/// Ephemeral updates, presence and account data never produce timeline locators.
+#[derive(Clone, Debug, PartialEq, Eq, uniffi::Record)]
+pub struct SyncTimelineChangesV2 {
+    pub rooms: Vec<SyncRoomTimelineChangeV2>,
+    /// At least one room could not be represented. Reconcile the admitted inventory.
+    pub rescan_required: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, uniffi::Enum)]
+pub enum SyncTimelineMembershipV2 {
+    Joined,
+    Left,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, uniffi::Record)]
+pub struct SyncRoomTimelineChangeV2 {
+    pub room_id: String,
+    pub membership: SyncTimelineMembershipV2,
+    /// Ordered unique IDs only, including encrypted, redacted and unknown event types.
+    pub event_ids: Vec<String>,
+    /// The provider or this bounded projection omitted timeline events for this room.
+    /// Recover this room even when event_ids is empty.
+    pub limited: bool,
+}
+
+const TIMELINE_ROOM_LIMIT: usize = 64;
+const TIMELINE_EVENT_LIMIT: usize = 64;
+const TIMELINE_BATCH_EVENT_LIMIT: usize = 256;
+const TIMELINE_LOCATOR_BYTES: usize = 1024;
+
+fn timeline_changes(updates: &RoomUpdates) -> SyncTimelineChangesV2 {
+    let mut changes = SyncTimelineChangesV2 { rooms: Vec::new(), rescan_required: false };
+    let mut remaining_events = TIMELINE_BATCH_EVENT_LIMIT;
+    let mut retained_rooms = BTreeSet::new();
+    let timelines = updates
+        .joined
+        .iter()
+        .map(|(id, room)| (id, &room.timeline, SyncTimelineMembershipV2::Joined))
+        .chain(
+            updates
+                .left
+                .iter()
+                .map(|(id, room)| (id, &room.timeline, SyncTimelineMembershipV2::Left)),
+        );
+    for (id, timeline, membership) in timelines {
+        if timeline.events.is_empty() && !timeline.limited {
+            continue;
+        }
+        if changes.rooms.len() == TIMELINE_ROOM_LIMIT {
+            changes.rescan_required = true;
+            break;
+        }
+        if id.as_str().len() > TIMELINE_LOCATOR_BYTES || !retained_rooms.insert(id) {
+            changes.rescan_required = true;
+            continue;
+        }
+        let (event_ids, limited) = timeline_locators(timeline, &mut remaining_events);
+        changes.rooms.push(SyncRoomTimelineChangeV2 {
+            room_id: id.to_string(),
+            membership,
+            event_ids,
+            limited,
+        });
+    }
+    changes
+}
+
+fn timeline_locators(timeline: &Timeline, remaining: &mut usize) -> (Vec<String>, bool) {
+    let mut ids = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut limited = timeline.limited || timeline.events.len() > TIMELINE_EVENT_LIMIT;
+    // Inspect a bounded prefix even if a malicious batch repeats or omits every ID.
+    for event in timeline.events.iter().take(TIMELINE_EVENT_LIMIT) {
+        let Some(id) = event.event_id().filter(|id| id.as_str().len() <= TIMELINE_LOCATOR_BYTES)
+        else {
+            limited = true;
+            continue;
+        };
+        if !seen.insert(id) {
+            continue;
+        }
+        if *remaining == 0 {
+            limited = true;
+            break;
+        }
+        ids.push(id.to_string());
+        *remaining -= 1;
+    }
+    (ids, limited)
+}
