+#[tokio::test]
+async fn sync_hints_cancellation_before_response_keeps_previous_position() {
+    let server = MatrixMockServer::new().await;
+    let client = server.client_builder().build().await;
+    let guard = server.mock_sync().ok(|_| {}).mock_once().mount_as_scoped().await;
+    let previous = client.sync_once(SyncSettings::default()).await.unwrap().next_batch;
+    drop(guard);
+    let guard = server
+        .mock_sync()
+        .with_delay(Duration::from_secs(20))
+        .ok(|_| {})
+        .mock_once()
+        .mount_as_scoped()
+        .await;
+    let read = client.clone();
+    let pending = tokio::spawn(async move { read.sync_once(SyncSettings::default()).await });
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if server
+                .server()
+                .received_requests()
+                .await
+                .unwrap()
+                .iter()
+                .filter(|r| r.url.path().ends_with("/sync"))
+                .count()
+                == 2
+            {
+                break;
+            }
+            sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .unwrap();
+    pending.abort();
+    assert!(pending.await.unwrap_err().is_cancelled());
+    assert_eq!(client.sync_token().await, Some(previous));
+    drop(guard);
+}
